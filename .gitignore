# OS / editor cruft
.DS_Store
Thumbs.db
*.log
*.zip

# Secrets (never commit)
secrets.env
secrets.env.local
.env

# Station lab runtime (local state, never commit; rebuild via station/setup.sh)
broadcast/
station/overlay_state.json

# Pinned third-party binaries (fetched by setup.sh, never committed)
station/third_party/

# Build artifacts
dist/
_site/

# Legacy Python bridge artifacts (kept for ref; the bridge is removed from this repo)
__pycache__/
*.pyc
.venv/
venv/

# Smile profile (per-host local state)
smile-profile/
active.json

# Node modules (if anyone runs html-validate locally)
node_modules/

# MediaMTX self-signed certs (regenerated on demand)
auto.crt
auto.key

# Per-machine config overrides (sync.py apply merges these over repo config)
station/config/local.json
