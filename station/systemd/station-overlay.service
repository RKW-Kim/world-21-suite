[Unit]
Description=Station overlay server (pages + SSE state push)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/GitHub/world-21-suite
# LAN-exposed so contributor/operator browsers can reach /console: home LAN
# here; on the VPS this stays behind the SSH tunnel (never raw internet).
Environment=BIND=0.0.0.0
ExecStart=/usr/bin/python3 station/overlay_server.py 7070
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
