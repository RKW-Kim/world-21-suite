[Unit]
Description=Station playout daemon (loop, watchdog, cache, alerts)
After=station-obs.service
# Wants=, not Requires=: AGENTS.md says the daemon must survive a plane
# restart. With Requires= the daemon's OWN watchdog heal (it stops
# station-obs) stopped the daemon too, and three OBS crashes in 10
# minutes put the plane in "failed" and took the playout engine with it.

[Service]
Type=simple
WorkingDirectory=%h/Documents/GitHub/world-21-suite
EnvironmentFile=%h/Documents/GitHub/world-21-suite/broadcast/secrets.env
Environment=OBS_READY_TRIES=60
Environment=WATCH_POLL=2
ExecStart=/usr/bin/python3 station/daemon.py loop
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
