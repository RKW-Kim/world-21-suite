[Unit]
Description=Station render plane (headless OBS, SMILE collection)
After=station-xvfb.service
Requires=station-xvfb.service
# Rate cap on restarts: a crash-looping renderer must hold STOPPED and shout,
# not spin 20 restarts in 30 minutes behind our backs (seen 2026-10-14).
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
Environment=DISPLAY=:99
ExecStart=/usr/bin/flatpak run --socket=x11 --env=DISPLAY=:99 com.obsproject.Studio --verbose --minimize-to-tray
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
