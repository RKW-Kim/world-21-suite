[Unit]
Description=Station render plane (headless OBS, SMILE collection)
After=station-xvfb.service
Requires=station-xvfb.service
# Rate cap on restarts: a crash-looping renderer must hold STOPPED and shout,
# not spin 20 restarts in 30 minutes behind our backs (seen 2026-10-14).
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# DISPLAY PICKING (root-caused 2026-10-15): Qt prefers Wayland when
# WAYLAND_DISPLAY leaks in from the user session, so OBS kept opening on the
# real Hyprland desktop (incl. its safe-mode dialog) instead of Xvfb :99.
# Pin Qt to xcb + hide Wayland entirely; never touch the user's screen again.
Environment=DISPLAY=:0
Environment=PLANE_DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
UnsetEnvironment=WAYLAND_DISPLAY
# Headless hardening (learned 2026-10-15): no missing-files dialog (nothing
# may block for a click), CEF singleton cleanup (stale locks wedge boots
# after hard kills), and .sentinel/run_* cleanup (leftover run markers ARE
# the safe-mode trigger; without this every unclean boot parks at "Run in
# Normal Mode?" forever).
# LIBGL_ALWAYS_SOFTWARE removed 2026-10-20: on the Intel HD 520 it chained
# the plane to llvmpipe; at the real-window resolution the renderer burned
# ~2x realtime CPU and the websocket starved (boot brownouts "not ready
# n/60"). Hardware GL on the iGPU measured faster and cooler; revert this
# line + the flatpak --env= flag below if a boot ever wedges on GL again.
Environment=QT_DEBUG_PLUGINS=1
ExecStartPre=/bin/sh -c 'pkill -x bwrap; pkill -x obs; i=0; while pgrep -x obs >/dev/null 2>&1 && [ $i -lt 40 ]; do sleep 1; i=$((i+1)); done; sleep 2; rm -f %h/.var/app/com.obsproject.Studio/config/obs-studio/.sentinel/run_* %h/.var/app/com.obsproject.Studio/config/obs-studio/plugin_config/obs-browser/SingletonLock %h/.var/app/com.obsproject.Studio/config/obs-studio/plugin_config/obs-browser/SingletonSocket %h/.var/app/com.obsproject.Studio/config/obs-studio/plugin_config/obs-browser/SingletonCookie'
# --minimize-to-tray (removed 2026-10-18): Qt hid the main window on a
# no-tray Xvfb display some boots (WebSocketServer ran, root screen empty —
# black VNC). Xvfb has no tray; the window must plain OPEN instead.
ExecStart=/usr/bin/flatpak run --socket=x11 --nosocket=wayland --nosocket=fallback-x11 --env=DISPLAY=:0 --env=PLANE_DISPLAY=:0 --env=QT_QPA_PLATFORM=xcb com.obsproject.Studio --verbose --disable-missing-files-check
# Fullscreen boot (added 2026-10-18): OBS ignores the saved geometry some
# boots and opens its default 896x482 window — for a VNC TD desk that reads
# as half-visible UI. Poll and force the main window to the full Xvfb frame
# (1280x720) whatever OBS remembers; operation = idempotent XMoveResize.
# The poll runs DETACHED (nohup + &): a blocking ExecStartPost stays inside
# systemd's 90s default start window, and a slow boot (extra plugins make
# OBS slower to open its window) got OBS killed by its own start timeout
# three times before this fix. TimeoutStartSec raised for extra margin.
TimeoutStartSec=180
ExecStartPost=/bin/sh -c 'nohup /bin/sh -c "i=0; while [ \$i -lt 120 ]; do sleep 2; i=\$((i+1)); if python3 %h/Documents/GitHub/world-21-suite/station/obs_click.py --resize 0 0 1280 720 >/dev/null 2>&1; then exit 0; fi; done" >/dev/null 2>&1 & exit 0'
# systemctl stop does NOT reap the flatpak/bwrap tree (seen live: unit
# inactive, old obs still holding :4455, new instance parking at "already
# running"). Reap by exact comm names on every stop, not just restarts.
ExecStop=/bin/sh -c 'pkill -x obs; pkill -x bwrap; exit 0'
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
