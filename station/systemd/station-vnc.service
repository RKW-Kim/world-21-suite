[Unit]
Description=Station VNC bridge (mirrors the Hyprland session, incl. the OBS window on :0)

[Service]
Type=simple
# 2026-10-20: x11vnc REPLACED by wayvnc. OBS now lives on XWayland :0
# (it must, for iGPU hardware GL — Xvfb :99 cannot host GLX at all, which
# was the llvmpipe 2x-CPU burn), and x11vnc 0.9.17 cannot scrape XWayland:
# it aborts with "BadMatch (X_GetImage)" forever. wayvnc attaches to the
# Hyprland session (wlr-screencopy) natively and mirrors the whole desktop.
# It wants the user-session Wayland env — do NOT UnsetEnvironment here.
# Config: %h/.config/wayvnc/wayvnc-station.ini — binds 127.0.0.1 only, so
# the SSH tunnel stays the real gate; password auth because macOS Screen
# Sharing cannot cope with a passwordless VNC server (it hangs asking for
# a password that doesn't exist). Password is in the ini (mode 0600).
ExecStart=/usr/bin/wayvnc --config=%h/.config/wayvnc/wayvnc-station.ini
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
