<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SMILE · V8 — Precision</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600&display=swap');
:root{
  --c-accent:#FFC107;--c-accent-rgb:255,193,7;--c-bg:#0a0a0b;--c-fg:#fafafa;--c-muted:#a1a1aa;--c-faint:#6b6b74;
  --c-border:#232326;--c-on-accent:#0a0a0a;--c-up:#0ECB81;--c-down:#F6465D;
  --expo:cubic-bezier(.16,1,.3,1);
  --font-display:'Space Grotesk',system-ui,sans-serif;--font-mono:'IBM Plex Mono',ui-monospace,monospace;--font-body:'Inter',system-ui,sans-serif;
  --strap-x:32px;--strap-bottom:98px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#000}
body{font-family:var(--font-body);color:var(--c-fg);-webkit-font-smoothing:antialiased;user-select:none}
svg{display:block}
.stage{position:absolute;inset:0;background:var(--c-bg)}
.bg-grad{position:absolute;inset:0;overflow:hidden;background:radial-gradient(40% 32% at 15% 18%,rgba(var(--c-accent-rgb),.1),transparent 70%),radial-gradient(28% 24% at 82% 24%,rgba(45,212,191,.06),transparent 70%),radial-gradient(circle at 50% 46%,var(--c-bg),var(--c-bg))}
.market-bg{position:absolute;left:0;right:0;bottom:78px;height:42vh;min-height:260px;opacity:.28;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 32%);mask-image:linear-gradient(180deg,transparent 0,#000 32%)}
.market-bg svg{width:100%;height:100%}
#help{position:fixed;top:24px;left:24px;z-index:99;font-family:var(--font-mono);font-size:11px;line-height:2;color:var(--c-muted);background:#101013;border:1px solid var(--c-border);border-radius:10px;padding:10px 14px;transition:opacity .3s}
#help.off{opacity:0;pointer-events:none}
#help b{color:var(--c-accent)}
.smile{transform-box:fill-box;transform-origin:center;filter:drop-shadow(0 2px 3px rgba(0,0,0,.45))}
.smile .face{fill:var(--c-accent)}
.smile .eye{fill:var(--c-on-accent);transform-box:fill-box;transform-origin:center;transition:transform .12s ease}
.smile .mouth{fill:none;stroke:var(--c-on-accent);stroke-width:7.5;stroke-linecap:round;stroke-linejoin:round;transition:d .4s var(--expo)}
.smile.is-grin .mouth{d:path("M 15 44 A 35 35 0 0 0 85 44")}
.smile.is-frown .mouth{d:path("M 30 64 A 22 22 0 0 1 70 64")}
.smile.is-frown .eye{transform:scale(.85)}
.smile.is-blink .eye{transform:scaleY(.08)}
.smile.is-nod{animation:nod .7s var(--expo)}
@keyframes nod{0%,100%{transform:rotate(0)}30%{transform:rotate(7deg) translateY(1px)}60%{transform:rotate(-3deg)}}
.smile.is-celebrate{animation:cel .9s var(--expo)}
@keyframes cel{0%{transform:scale(1)}30%{transform:scale(1.09)}60%{transform:scale(1.04)}100%{transform:scale(1)}}
.smile.is-shake{animation:shake .5s ease}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-2px)}50%{transform:translateX(2px)}75%{transform:translateX(-1px)}}
.goalmark{position:relative;width:32px;height:32px;flex:none}
.goalmark .gring-svg{position:absolute;inset:-3px;width:38px;height:38px}
.goalmark .smile{position:absolute;inset:0;width:100%;height:100%}
.gring-track{fill:none;stroke:rgba(10,10,10,.25);stroke-width:4}
.gring{fill:none;stroke:var(--c-on-accent);stroke-width:4;stroke-linecap:round;stroke-dasharray:100;stroke-dashoffset:100;transform:rotate(-90deg);transform-origin:center;transition:stroke-dashoffset 1.2s var(--expo)}
.ticker{position:absolute;left:10px;right:10px;bottom:10px;height:74px;z-index:40;display:flex;align-items:stretch;overflow:hidden;background:#101013;border:1px solid var(--c-border);border-radius:16px;box-shadow:0 12px 32px rgba(0,0,0,.5);animation:tickin .9s var(--expo) .15s backwards}
@keyframes tickin{from{transform:translateY(90px);opacity:0}to{transform:none;opacity:1}}
.tline{position:absolute;top:0;left:0;right:0;height:2px;z-index:7;transform:scaleX(0);transform-origin:left;opacity:0;pointer-events:none}
.tline.up{background:var(--c-up)} .tline.dn{background:var(--c-down)}
.ticker.alert-up .tline.up,.ticker.alert-dn .tline.dn{animation:linedraw 2.6s var(--expo) forwards}
@keyframes linedraw{0%{transform:scaleX(0);opacity:1}22%{transform:scaleX(1);opacity:1}78%{transform:scaleX(1);opacity:1}100%{transform:scaleX(1);opacity:0}}
.cap{display:flex;align-items:center;gap:11px;padding:0 26px;white-space:nowrap;font-family:var(--font-display);font-weight:700;font-size:12px;letter-spacing:.18em}
.cap.left{background:var(--c-accent);color:var(--c-on-accent);z-index:6}
.cells{flex:1;display:flex;align-items:stretch;min-width:0;z-index:6}
.cell{flex:1;display:flex;flex-direction:column;justify-content:center;gap:7px;padding:0 20px;min-width:0;position:relative;opacity:0;transform:translateY(10px);animation:cellin .7s var(--expo) forwards}
.cell:nth-child(1){animation-delay:.5s}.cell:nth-child(2){animation-delay:.57s}.cell:nth-child(3){animation-delay:.64s}
.cell:nth-child(4){animation-delay:.71s}.cell:nth-child(5){animation-delay:.78s}.cell:nth-child(6){animation-delay:.85s}
@keyframes cellin{to{opacity:1;transform:none}}
.cell + .cell{border-left:1px solid var(--c-border)}
.cell.fup{animation:cellin .7s var(--expo) forwards,fup .8s ease}
.cell.fdn{animation:cellin .7s var(--expo) forwards,fdn .8s ease}
@keyframes fup{0%{background:rgba(14,203,129,var(--heat,.1))}100%{background:transparent}}
@keyframes fdn{0%{background:rgba(246,70,93,var(--heat,.1))}100%{background:transparent}}
.ctop{display:flex;align-items:center;justify-content:space-between;gap:8px}
.csym{font-family:var(--font-mono);font-size:9.5px;font-weight:600;letter-spacing:.16em;color:var(--c-faint)}
.cchg{display:inline-flex;align-items:center;gap:5px;font-family:var(--font-mono);font-size:9px;font-weight:700;border-radius:5px;padding:2.5px 7px}
.cchg.up{color:var(--c-up);background:rgba(14,203,129,.1)}
.cchg.down{color:var(--c-down);background:rgba(246,70,93,.1)}
.caret{width:0;height:0;border-left:3px solid transparent;border-right:3px solid transparent}
.caret.up{border-bottom:4px solid var(--c-up)} .caret.down{border-top:4px solid var(--c-down)}
.cval{font-family:var(--font-display);font-weight:700;font-size:20px;font-variant-numeric:tabular-nums;color:var(--c-fg);line-height:1}
.cval.roll{animation:roll .5s var(--expo)}
@keyframes roll{0%{transform:translateY(45%);opacity:0}100%{transform:none;opacity:1}}
.cell.wire .csym{color:var(--c-accent)}
.cell.wire .wprog{position:absolute;left:20px;right:20px;bottom:12px;height:1px;background:rgba(255,255,255,.08);overflow:hidden}
.cell.wire .wprog i{display:block;height:100%;background:var(--c-accent);transform-origin:left;animation:wprog var(--wire-dur,7s) linear forwards}
@keyframes wprog{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.cell.wire .widx{position:absolute;top:12px;right:20px;font-family:var(--font-mono);font-size:8px;letter-spacing:.1em;color:var(--c-faint)}
.cell.wire .wswap{overflow:hidden;display:block}
.cell.wire .wswap > span{display:block;transition:transform .45s var(--expo),opacity .3s ease}
.cell.wire.swapping .wswap > span{transform:translateY(-110%);opacity:0}
.cell.wire.moving .csym::after{content:" · MOVING";color:var(--c-down)}
#dclock{padding:0 18px;display:flex;flex-direction:column;justify-content:center;gap:3px;font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;color:var(--c-faint);white-space:nowrap;border-left:1px solid var(--c-border);align-self:stretch}
#dtime{color:var(--c-muted);font-size:10px}
#strap{position:fixed;left:0;bottom:var(--strap-bottom);z-index:45;pointer-events:none;padding-left:var(--strap-x);padding-right:48px;clip-path:inset(-20px 100% -30px 0);opacity:0;transition:clip-path .55s var(--expo),opacity .18s ease .4s}
#strap.on{clip-path:inset(-20px -10% -30px 0);opacity:1;transition:clip-path .55s var(--expo),opacity .18s ease}
#strap .scrim{position:absolute;left:0;top:-60px;bottom:-46px;width:820px;z-index:-1;pointer-events:none;background:linear-gradient(90deg,rgba(10,10,11,.9),rgba(10,10,11,.42) 52%,transparent 88%);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);-webkit-mask-image:linear-gradient(90deg,#000 45%,transparent 92%);mask-image:linear-gradient(90deg,#000 45%,transparent 92%)}
#strap .stack{position:relative;min-width:0}
.mw{overflow:hidden;display:block}
#strap .kick{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.24em;color:var(--c-fg);margin-bottom:7px;transform:translateY(130%);transition:transform .2s ease}
#strap.on .kick{transform:none;transition:transform .5s var(--expo) .1s}
#strap .tick{width:8px;height:8px;flex:none;background:var(--c-accent)}
#strap.st-tp .tick{background:var(--c-up)} #strap.st-sl .tick{background:var(--c-down)}
#strap.st-note .tick{background:var(--c-faint)}
#strap .head{font-family:var(--font-display);font-weight:700;font-size:31px;letter-spacing:-.02em;line-height:1.05;white-space:nowrap;transform:translateY(115%);transition:transform .2s ease}
#strap.on .head{transform:none;transition:transform .55s var(--expo) .17s}
#strap.st-note .head{font-size:22px;color:var(--c-muted)}
#strap .rule{display:block;height:2px;width:64px;background:var(--c-accent);margin-top:9px;transform:scaleX(0);transform-origin:left;transition:transform .18s ease,background .3s}
#strap.on .rule{transform:none;transition:transform .5s var(--expo) .3s}
#strap.st-tp .rule{background:var(--c-up)} #strap.st-sl .rule{background:var(--c-down)}
#strap .sub{font-size:13px;color:var(--c-muted);margin-top:8px;white-space:nowrap;transform:translateY(140%);transition:transform .2s ease}
#strap.on .sub{transform:none;transition:transform .45s var(--expo) .34s}
#strap .ladder{display:none;align-items:center;gap:10px;margin-top:11px;width:230px;opacity:0;transition:opacity .18s ease}
#strap .ladder.show{display:flex}
#strap.on .ladder.show{opacity:1;transition:opacity .4s ease .42s}
#strap .ll{font-family:var(--font-mono);font-size:8.5px;font-weight:700;letter-spacing:.14em}
#strap .ll.sl{color:var(--c-down)} #strap .ll.tp{color:var(--c-up)}
#strap .lbar{position:relative;flex:1;height:2px;background:linear-gradient(90deg,rgba(246,70,93,.6),rgba(255,255,255,.14) 50%,rgba(14,203,129,.6))}
#strap .lbar i{position:absolute;top:50%;left:50%;width:9px;height:9px;border-radius:50%;background:#fff;transform:translate(-50%,-50%);transition:left .8s var(--expo)}
#strap .num{position:absolute;left:min(430px,52vw);top:2px;text-align:left;opacity:0;transform:translateY(10px);transition:.2s ease}
#strap.on .num{opacity:1;transform:none;transition:.45s var(--expo) .3s}
#strap .num .n{font-family:var(--font-display);font-weight:700;font-size:30px;font-variant-numeric:tabular-nums;line-height:1}
#strap .num .n.up{color:var(--c-up)} #strap .num .n.dn{color:var(--c-down)}
#strap .num .nl{font-family:var(--font-mono);font-size:9px;letter-spacing:.2em;color:var(--c-faint);margin-top:5px}
body.light{--c-bg:#f4f4f2;--c-fg:#111113;--c-muted:#52525b;--c-faint:#8a8a93;--c-border:#dcdcd6}
body.light .ticker{background:#ffffff;box-shadow:0 12px 32px rgba(0,0,0,.12)}
body.light #help{background:#ffffff}
body.light #strap .scrim{background:linear-gradient(90deg,rgba(244,244,242,.92),rgba(244,244,242,.45) 52%,transparent 88%)}
body.light .market-bg{opacity:.18}
body.light .bg-grad{background:radial-gradient(40% 32% at 15% 18%,rgba(var(--c-accent-rgb),.14),transparent 70%),radial-gradient(circle at 50% 46%,var(--c-bg),var(--c-bg))}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01s !important;transition-duration:.01s !important}}
body.perf-low .ticker,body.perf-low #strap .scrim{backdrop-filter:none;-webkit-backdrop-filter:none}
</style>
</head>
<body>
<div class="stage">
  <div class="bg-grad"></div>
  <div class="market-bg"><svg viewBox="0 0 1920 460" preserveAspectRatio="none">
    <defs><linearGradient id="mg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFC107" stop-opacity=".22"/><stop offset="1" stop-color="#FFC107" stop-opacity="0"/>
    </linearGradient></defs>
    <path d="M0 380 L160 350 L320 385 L480 320 L640 350 L800 270 L960 305 L1120 220 L1280 260 L1440 180 L1600 215 L1760 140 L1920 165 L1920 460 L0 460 Z" fill="url(#mg)"/>
    <path d="M0 380 L160 350 L320 385 L480 320 L640 350 L800 270 L960 305 L1120 220 L1280 260 L1440 180 L1600 215 L1760 140 L1920 165" fill="none" stroke="#FFC107" stroke-width="1.5"/>
  </svg></div>
</div>
<div id="help"><b>V8 — PRECISION</b><br>
[1] hide [2] lesson [3] TP [4] SL [5] poll [6] host [7] goal<br>
[8] wire &nbsp;[9] force wire swap &nbsp;[B] market &nbsp;[L] light scene &nbsp;[H] hide this</div>
<div id="strap">
  <div class="scrim"></div>
  <div class="stack">
    <span class="mw"><span class="kick"><span class="tick"></span><span id="sKick"></span></span></span>
    <span class="mw"><span class="head" id="sHead"></span></span>
    <span class="rule"></span>
    <span class="mw"><span class="sub" id="sSub"></span></span>
    <div class="ladder" id="sLadder"><span class="ll sl">SL</span><div class="lbar"><i id="sDot"></i></div><span class="ll tp">TP</span></div>
    <div class="num"><div class="n" id="sNum"></div><div class="nl" id="sNumLbl"></div></div>
  </div>
</div>
<div class="ticker" id="ticker">
  <div class="tline up"></div><div class="tline dn"></div>
  <div class="cap left">
    <div class="goalmark">
      <svg class="gring-svg" viewBox="0 0 100 100">
        <circle class="gring-track" cx="50" cy="50" r="46" pathLength="100"/>
        <circle class="gring" id="gring" cx="50" cy="50" r="46" pathLength="100"/>
      </svg>
      <svg class="smile" id="capSmile" viewBox="0 0 100 100">
        <circle class="face" cx="50" cy="50" r="48"/>
        <circle class="eye" cx="31" cy="35" r="5.5"/><circle class="eye" cx="69" cy="35" r="5.5"/>
        <path class="mouth" d="M 20 48 A 30 30 0 0 0 80 48"/>
      </svg>
    </div>
    SMILE · LIVE
  </div>
  <div class="cells" id="cells"></div>
  <div id="dclock"><span id="dtime"></span><span>DATA · DEMO</span></div>
</div>
<script>
const TL={
  running:null,
  play(seq){ this.stop(); const timers=seq.map(s=>setTimeout(s.fn,s.at)); this.running={timers} },
  stop(){ if(this.running){this.running.timers.forEach(clearTimeout);this.running=null} }
};
const root=document.documentElement;
function alignStrap(){
  const firstCell=document.querySelector('.cell');
  if(!firstCell)return;
  const r=firstCell.getBoundingClientRect();
  const cs=getComputedStyle(firstCell);
  root.style.setProperty('--strap-x',(r.left+parseFloat(cs.paddingLeft))+'px');
  const ticker=document.getElementById('ticker').getBoundingClientRect();
  root.style.setProperty('--strap-bottom',(innerHeight-ticker.top+24)+'px');
}
new ResizeObserver(alignStrap).observe(document.body);
addEventListener('resize',alignStrap);
const Power={
  awake:true,
  every(fn,ms){ return setInterval(()=>{if(this.awake)fn()},ms) },
  init(){
    document.addEventListener('visibilitychange',()=>{ this.awake=!document.hidden });
    if(matchMedia('(prefers-reduced-motion: reduce)').matches)document.body.classList.add('perf-low');
    if(new URLSearchParams(location.search).get('perf')==='low')document.body.classList.add('perf-low');
  }
};
Power.init();
const SESSIONS=[
  {name:'sydney', from:1,  to:9,  w:1, trades:['AUD','NZD']},
  {name:'tokyo',  from:3,  to:11, w:2, trades:['JPY','AUD','XAU']},
  {name:'london', from:10, to:18, w:3, trades:['EUR','GBP','CHF','XAU','UK']},
  {name:'newyork',from:15, to:23, w:3, trades:['USD','XAU','NAS','SPX','NVDA','AAPL','TSLA','US30','OIL']},
  {name:'nse',    from:10, to:15, w:2, trades:['KES','NSE']}
];
function sessionScore(tags){
  const h=new Date().getHours();
  let s=0;
  for(const ses of SESSIONS){
    const open = ses.from<ses.to ? (h>=ses.from&&h<ses.to) : (h>=ses.from||h<ses.to);
    if(open && tags.some(t=>ses.trades.includes(t))) s+=ses.w;
  }
  return s;
}
const PINNED=[
  {s:'EUR/USD',p:1.0842,dp:4,chg:+.12,tags:['EUR','USD'],th:.0003},
  {s:'GBP/USD',p:1.2691,dp:4,chg:-.08,tags:['GBP','USD'],th:.0003},
  {s:'USD/JPY',p:151.44,dp:2,chg:+.31,tags:['USD','JPY'],th:.0003},
  {s:'XAU/USD',p:2384.5,dp:1,chg:+.45,tags:['XAU','USD'],th:.0005},
  {s:'BTC/USD',p:67240,dp:0,chg:-1.20,tags:['CRYPTO'],th:.0015}
];
const UNIVERSE=[
  {s:'NAS100', p:18240, dp:0,chg:+.42,tags:['NAS','USD'],th:.0005},
  {s:'SPX500', p:5212,  dp:0,chg:+.18,tags:['SPX','USD'],th:.0005},
  {s:'US30',   p:39112, dp:0,chg:+.22,tags:['US30','USD'],th:.0005},
  {s:'NVDA',   p:878.4, dp:1,chg:+2.10,tags:['NVDA','USD'],th:.001},
  {s:'AAPL',   p:173.2, dp:1,chg:-.34,tags:['AAPL','USD'],th:.001},
  {s:'TSLA',   p:177.9, dp:1,chg:-1.62,tags:['TSLA','USD'],th:.001},
  {s:'ETH/USD',p:3412,  dp:0,chg:+.86,tags:['CRYPTO'],th:.0015},
  {s:'SOL/USD',p:172.4, dp:1,chg:+3.20,tags:['CRYPTO'],th:.0015},
  {s:'EUR/GBP',p:.8542, dp:4,chg:+.05,tags:['EUR','GBP'],th:.0003},
  {s:'USD/KES',p:129.5, dp:2,chg:-.12,tags:['KES','USD'],th:.0003},
  {s:'NSE 25', p:2984,  dp:0,chg:+.31,tags:['NSE','KES'],th:.0005},
  {s:'US OIL', p:82.40, dp:2,chg:-.74,tags:['OIL','USD'],th:.0008}
];
function rescore(){ UNIVERSE.forEach(u=>u.score=sessionScore(u.tags)+(u.tags.includes('CRYPTO')?0.5:0)); UNIVERSE.sort((a,b)=>b.score-a.score); }
rescore(); setInterval(rescore,60000);
const cellsEl=document.getElementById('cells');
function fmt(x){return x.p.toLocaleString('en-US',{minimumFractionDigits:x.dp,maximumFractionDigits:x.dp})}
function cellHTML(x,i,wire){
  return `<div class="cell${wire?' wire':''}" id="cell${i}">
    ${wire?`<span class="widx" id="widx"></span>`:''}
    <div class="ctop"><span class="wswap"><span class="csym" id="sym${i}">${x.s}</span></span>
      <span class="cchg ${x.chg>=0?'up':'down'}" id="chg${i}"><span class="caret ${x.chg>=0?'up':'down'}"></span>${x.chg>=0?'+':''}${x.chg.toFixed(2)}%</span></div>
    <span class="wswap"><span class="cval" id="val${i}">${fmt(x)}</span></span>
    ${wire?`<div class="wprog"><i id="wprog"></i></div>`:''}
  </div>`;
}
cellsEl.innerHTML=PINNED.map((x,i)=>cellHTML(x,i,false)).join('')+cellHTML(UNIVERSE[0],5,true);
function tick(x,i){
  const delta=(Math.random()-.48)*x.p*.0012;
  x.p+=delta;x.chg+=delta/x.p*100;
  const significant=Math.abs(delta)/x.p>=x.th;
  const val=document.getElementById('val'+i),chg=document.getElementById('chg'+i),cell=document.getElementById('cell'+i);
  if(!val)return;
  val.textContent=fmt(x);
  chg.innerHTML=`<span class="caret ${x.chg>=0?'up':'down'}"></span>${x.chg>=0?'+':''}${x.chg.toFixed(2)}%`;
  chg.className='cchg '+(x.chg>=0?'up':'down');
  if(significant){
    const heat=Math.min(.22,.06+(Math.abs(delta)/x.p/x.th)*.05);
    cell.style.setProperty('--heat',heat.toFixed(3));
    val.classList.remove('roll');void val.offsetWidth;val.classList.add('roll');
    cell.classList.remove('fup','fdn');void cell.offsetWidth;cell.classList.add(delta>=0?'fup':'fdn');
  }
}
let wireIx=0,wireLock=0;
const WIRE_DUR=7000;
function paintWire(){
  const x=UNIVERSE[wireIx],cell=document.getElementById('cell5');
  document.getElementById('sym5').textContent=x.s;
  document.getElementById('val5').textContent=fmt(x);
  const chg=document.getElementById('chg5');
  chg.innerHTML=`<span class="caret ${x.chg>=0?'up':'down'}"></span>${x.chg>=0?'+':''}${x.chg.toFixed(2)}%`;
  chg.className='cchg '+(x.chg>=0?'up':'down');
  document.getElementById('widx').textContent=(wireIx+1)+'/'+UNIVERSE.length;
  const p=document.getElementById('wprog');
  p.style.setProperty('--wire-dur',WIRE_DUR+'ms');
  p.style.animation='none';void p.offsetWidth;p.style.animation='';
  cell.classList.toggle('moving',wireLock>0);
}
function swapWire(){
  if(wireLock>0){wireLock--;paintWire();return}
  const cell=document.getElementById('cell5');
  cell.classList.add('swapping');
  setTimeout(()=>{ wireIx=(wireIx+1)%UNIVERSE.length; paintWire(); cell.classList.remove('swapping'); },460);
}
Power.every(swapWire,WIRE_DUR);
paintWire();
Power.every(()=>{ PINNED.forEach((x,i)=>tick(x,i)); tick(UNIVERSE[wireIx],5); },1600);
Power.every(()=>{
  UNIVERSE.forEach((u,ix)=>{
    const delta=(Math.random()-.5)*u.p*.001;
    u.p+=delta;u.chg+=delta/u.p*100;
    if(Math.abs(delta)/u.p>=u.th*3 && ix!==wireIx){ wireIx=ix; wireLock=2; paintWire(); }
  });
},5000);
let goal=640;const GOAL_MAX=1000,gring=document.getElementById('gring');
function paintGoal(){gring.style.strokeDashoffset=100-(goal/GOAL_MAX*100)}
paintGoal();
Power.every(()=>{
  const before=goal;goal=Math.min(GOAL_MAX,goal+Math.floor(Math.random()*9));paintGoal();
  if(before<GOAL_MAX&&goal>=GOAL_MAX)STATES.goalHit();
},4000);
const capSmile=document.getElementById('capSmile');
function mood(cls){capSmile.classList.remove('is-nod','is-celebrate','is-shake');void capSmile.getBoundingClientRect();capSmile.classList.add(cls)}
function blink(){capSmile.classList.add('is-blink');setTimeout(()=>capSmile.classList.remove('is-blink'),150)}
Power.every(blink,6500);
function mouth(cls){capSmile.classList.remove('is-grin','is-frown');if(cls)capSmile.classList.add(cls)}
const ticker=document.getElementById('ticker');let lineTimer=null;
function alertLine(dir){
  clearTimeout(lineTimer);
  ticker.classList.remove('alert-up','alert-dn');void ticker.offsetWidth;
  ticker.classList.add(dir==='up'?'alert-up':'alert-dn');
  lineTimer=setTimeout(()=>ticker.classList.remove('alert-up','alert-dn'),2700);
}
const dtime=document.getElementById('dtime');
Power.every(()=>{ dtime.textContent=new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'}); },1000);
const strap=document.getElementById('strap');
const sKick=document.getElementById('sKick'),sHead=document.getElementById('sHead'),sSub=document.getElementById('sSub'),
  sNum=document.getElementById('sNum'),sNumLbl=document.getElementById('sNumLbl'),
  sLadder=document.getElementById('sLadder'),sDot=document.getElementById('sDot');
let countRaf=null,stBusy=false;
function countTo(target,dec,sign){
  cancelAnimationFrame(countRaf);
  const t0=performance.now(),dur=900;
  (function step(t){
    const k=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-k,3);
    sNum.textContent=sign+(target*e).toFixed(dec);
    if(k<1)countRaf=requestAnimationFrame(step);
  })(t0);
}
function showStrap(cls,k,h,s,opt){
  TL.stop();cancelAnimationFrame(countRaf);
  strap.classList.remove('on');void strap.offsetWidth;
  strap.className='on st-'+cls;
  sKick.textContent=k;sHead.innerHTML=h;sSub.innerHTML=s;
  sLadder.classList.toggle('show',!!opt.ladder);
  if(opt.ladder)setTimeout(()=>sDot.style.left=opt.ladder+'%',450);
  if(opt.count!=null){sNum.className='n '+(opt.dir||'');sNumLbl.textContent='PIPS';countTo(opt.count,1,opt.sign)}
  else{sNum.textContent=opt.n||'';sNum.className='n';sNumLbl.textContent=opt.nl||''}
  if(opt.ttl)TL.play([{at:opt.ttl,fn:hideStrap}]);
}
function hideStrap(){TL.stop();strap.classList.remove('on');mouth(null);stBusy=false}
const WIRE_CARDS=[
  {k:'DESK',h:'Live lesson Monday 9PM EAT',s:'one question in, one skill out — drop yours in chat'},
  {k:'NOTICE',h:'Demo account · education only',s:'trading involves risk · not financial advice',note:1},
  {k:'LESSON',h:'Chart School — part 2 of 4',s:'support & resistance · the mango test'},
  {k:'NOTICE',h:'Losses are tuition',s:'we show ours so you pay less of yours',note:1}
];
let wcIx=0;
function showWireCard(){
  if(stBusy||strap.classList.contains('on'))return;
  const w=WIRE_CARDS[wcIx%WIRE_CARDS.length];wcIx++;
  showStrap(w.note?'note':'lesson',w.k,w.h,w.s,{n:'smile.co.ke',nl:'',ttl:6500});
}
Power.every(showWireCard,90000);
const STATES={
  lesson:()=>{stBusy=true;showStrap('lesson','LESSON','Support & Resistance','Chart School · part 2 of 4 · the mango test',{n:'12:00',nl:'LEFT'})},
  tp:()=>{
    stBusy=true;mood('is-celebrate');mouth('is-grin');alertLine('up');
    showStrap('tp','LIVE TRADE · DEMO','Take Profit Hit','EUR/USD · long from 1.0810 · plan followed',{count:32,sign:'+',dir:'up',ladder:88,ttl:7000});
  },
  sl:()=>{
    stBusy=true;mood('is-shake');mouth('is-frown');alertLine('dn');
    showStrap('sl','LIVE TRADE · DEMO','Stop Loss Hit','GBP/USD · short from 1.2720 · risk respected',{count:18,sign:'-',dir:'dn',ladder:6,ttl:7000});
  },
  poll:()=>{stBusy=true;showStrap('poll','POLL','You Pick the Next Lesson','A candles · B risk sizing · C news — type in chat',{n:'A·B·C',nl:'VOTE'})},
  name:()=>{stBusy=true;showStrap('name','HOST','Mwangi','Smile TV · Chart School · Nairobi',{n:'smile.co.ke',nl:'',ttl:6000})},
  goal:()=>{
    stBusy=true;mood('is-nod');
    showStrap('goal','STREAM GOAL',goal.toLocaleString()+' / '+GOAL_MAX.toLocaleString(),'ring on the smile tracks it live · thanks for the 4G smiles',{n:Math.round(goal/GOAL_MAX*100)+'%',nl:'FUNDED',ttl:6000});
  },
  goalHit:()=>{
    stBusy=true;mood('is-celebrate');mouth('is-grin');alertLine('up');
    showStrap('goal','GOAL COMPLETE',GOAL_MAX.toLocaleString()+' / '+GOAL_MAX.toLocaleString(),'the smile is full · new goal loading',{n:'100%',nl:'FUNDED',ttl:8000});
  }
};
function shedCells(){
  const w=innerWidth,cells=document.querySelectorAll('.cell');
  const show=w>1500?6:w>1280?5:4;
  cells.forEach((c,i)=>c.style.display=i<show?'flex':'none');
  alignStrap();
}
addEventListener('resize',shedCells);
addEventListener('keydown',e=>{
  const k=e.key.toLowerCase();
  if(k==='1')hideStrap();if(k==='2')STATES.lesson();if(k==='3')STATES.tp();
  if(k==='4')STATES.sl();if(k==='5')STATES.poll();if(k==='6')STATES.name();
  if(k==='7')STATES.goal();if(k==='8')showWireCard();if(k==='9')swapWire();
  if(k==='b')document.querySelector('.market-bg').style.opacity=
    document.querySelector('.market-bg').style.opacity==='0'?'':'0';
  if(k==='l')document.body.classList.toggle('light');
  if(k==='h')document.getElementById('help').classList.toggle('off');
});
alignStrap();shedCells();
setTimeout(STATES.name,900);
</script>
</body>
</html>
