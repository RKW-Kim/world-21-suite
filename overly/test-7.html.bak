<div id="toast"></div>
<script src="smile-mark.js"></script>
<script>
(function(){
var $=function(s){return document.querySelector(s);};
var $$=function(s){return Array.prototype.slice.call(document.querySelectorAll(s));};
var TWEAK_STORE='smile-suite-v7';
var q=new URLSearchParams(location.search);
var isControl=q.has('control');
var channel=('BroadcastChannel' in window)?new BroadcastChannel('smile-suite-v7'):{postMessage:function(){}};
var meetChan=('BroadcastChannel' in window)?new BroadcastChannel('smile-meet-live'):{postMessage:function(){}};
var instantTimer=null,resizeTimer=null,toastTimer=null;
var NAMES=['You · Host','Amara','Brian','Chloe','David','Elif','Farah','Gio','Kito'];
var FILTERS=['none','hue-rotate(45deg) saturate(1.35)','grayscale(1) contrast(1.25) brightness(1.05)','sepia(.55) hue-rotate(-18deg) saturate(1.2)','hue-rotate(160deg) saturate(1.1)','brightness(1.25) contrast(.9) saturate(1.7) hue-rotate(200deg)','hue-rotate(90deg) saturate(.65)','contrast(1.45) brightness(.8) hue-rotate(-60deg)','sepia(.3) hue-rotate(300deg) saturate(1.4)'];
var CROPS=['50% 50%','30% 40%','70% 35%','40% 65%','60% 60%','25% 30%','75% 70%','50% 30%','35% 55%'];
var SWATCH=['#FFC107','#7BD88F','#9aa0a6','#E8C39E','#63D8C7','#8EC9FF','#B8E986','#D88FB3','#F2A65A'];
var TZS=[['Asia/Tokyo','TOKYO','T'],['Europe/London','LONDON','L'],['America/New_York','NEW YORK','N']];
var RANGES={'Asia/Tokyo':[0,9],'Europe/London':[7,16],'America/New_York':[13,22]};

var defaultTweaks={
colors:{accent:'#FFC107',bg:'#09090b',cardRgb:'24,24,27',cardAlpha:0.78,border:'#27272a',fg:'#fafafa',muted:'#a1a1aa',faint:'#71717a',onAccent:'#0a0a0a',shadow:'rgba(0,0,0,0.45)'},
geometry:{radius:14,blur:12,borderWidth:1,shadowDepth:40,animMs:650},
layout:{showPip:true,showWm:true,showCluster:true,showTrades:true,showChat:true,showTicker:true,showMarket:true,showGlow:true,tickerEdge:'bottom',tickerFlipped:false,pipPos:'bl',tradesPos:'mr',margin:24,widgetWidth:380,pipWidth:376,pipRatio:'16/9',pipFit:'cover',tickerSpeed:55},
camera:{deviceId:'',mirror:false},
stage:{mode:'widgets'},
meet:{guests:4,strip:'bottom',autoSpeaker:true,mic:false,pinned:-1,muted:{}},
spot:{on:false,author:'mod',text:''},
edit:{on:false},
island:{mat:'liquid'},
cap:{goal:true,chats:true,plats:['yt','fb','tw'],announce:true,hold:10}
};

var THEME_PRESETS={
original:{colors:{accent:'#FFC107',bg:'#09090b',cardRgb:'24,24,27',cardAlpha:0.78,border:'#27272a',fg:'#fafafa',muted:'#a1a1aa',faint:'#71717a',onAccent:'#0a0a0a',shadow:'rgba(0,0,0,0.45)'},geometry:{radius:14,blur:12,borderWidth:1,shadowDepth:40,animMs:650}},
revolut:{colors:{accent:'#0068FF',bg:'#0A0E1A',cardRgb:'16,22,36',cardAlpha:0.86,border:'#1E293B',fg:'#F8FAFC',muted:'#94A3B8',faint:'#64748B',onAccent:'#FFFFFF',shadow:'rgba(2,6,23,0.55)'},geometry:{radius:20,blur:18,borderWidth:1,shadowDepth:34,animMs:720}},
bloomberg:{colors:{accent:'#FF8A00',bg:'#000000',cardRgb:'10,10,10',cardAlpha:0.96,border:'#2A2A2A',fg:'#FFB25E',muted:'#C77E2A',faint:'#8A5518',onAccent:'#000000',shadow:'rgba(0,0,0,0.9)'},geometry:{radius:2,blur:0,borderWidth:1,shadowDepth:0,animMs:260}},
stripe:{colors:{accent:'#635BFF',bg:'#F6F9FC',cardRgb:'255,255,255',cardAlpha:0.9,border:'#E3E8EF',fg:'#0A2540',muted:'#425466',faint:'#697386',onAccent:'#FFFFFF',shadow:'rgba(50,50,93,0.25)'},geometry:{radius:16,blur:0,borderWidth:1,shadowDepth:28,animMs:520}}
};

var SCENE_PRESETS={
full:{stage:{mode:'full'},layout:{showWm:true,showCluster:true,showTicker:true,margin:24}},
meetBottom:{stage:{mode:'meet'},meet:{strip:'bottom',guests:4}},
meetTop:{stage:{mode:'meet'},meet:{strip:'top',guests:4}},
meetRail:{stage:{mode:'meet'},meet:{strip:'right',guests:4}},
soloChat:{stage:{mode:'widgets'},layout:{showPip:true,showWm:true,showCluster:true,showTrades:false,showChat:true,showTicker:true,showMarket:true,pipPos:'ml',tradesPos:'mr',pipWidth:1040,widgetWidth:470,margin:28}},
soloTrades:{stage:{mode:'widgets'},layout:{showPip:true,showWm:true,showCluster:true,showTrades:true,showChat:false,showTicker:true,showMarket:true,pipPos:'ml',tradesPos:'mr',pipWidth:1040,widgetWidth:470,margin:28}},
desk:{stage:{mode:'widgets'},layout:{showPip:true,showWm:true,showCluster:true,showTrades:true,showChat:true,showTicker:true,showMarket:true,pipPos:'bl',tradesPos:'mr',pipWidth:470,widgetWidth:380,margin:24}},
minimal:{stage:{mode:'widgets'},layout:{showPip:true,showWm:true,showCluster:true,showTrades:false,showChat:false,showTicker:true,showMarket:false,pipPos:'br',pipWidth:320,pipRatio:'4/3',margin:20}}
};

var LAYERS=[
{name:'Webcam',showKey:'showPip',posKey:'pipPos'},
{name:'Trades',showKey:'showTrades',posKey:'tradesPos'},
{name:'Chat',showKey:'showChat'},
{name:'Island',showKey:'showCluster'},
{name:'Ticker',showKey:'showTicker',ticker:true},
{name:'Market',showKey:'showMarket'},
{name:'Glow',showKey:'showGlow'},
{name:'Full Cam',modeKey:'full'},
{name:'Guest Stage',modeKey:'meet'}
];
var EYE_OPEN='<svg class="eye-open" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
var EYE_CLOSED='<svg class="eye-closed" viewBox="0 0 24 24"><path d="M3 3l18 18"></path><path d="M10.6 5.1A10.9 10.9 0 0 1 12 5c6.5 0 10 6 10 6a17 17 0 0 1-2.2 3.2M6.1 6.1A16.7 16.7 0 0 0 2 11s3.5 6 10 6a10.7 10.7 0 0 0 3.2-.5"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>';

function mergeDeep(base,extra){var out=JSON.parse(JSON.stringify(base));(function w(a,b){for(var k in b){if(b[k]&&typeof b[k]==='object'&&a[k]&&typeof a[k]==='object')w(a[k],b[k]);else a[k]=b[k];}})(out,extra||{});return out;}
var saved={};try{saved=JSON.parse(localStorage.getItem(TWEAK_STORE))||{};}catch(e){}
var tweaks=mergeDeep(defaultTweaks,saved);

function hexToRgb(hex){hex=String(hex).replace('#','');if(hex.length===3)hex=hex.split('').map(function(c){return c+c;}).join('');var n=parseInt(hex,16);if(isNaN(n))return '24,24,27';return [(n>>16)&255,(n>>8)&255,n&255].join(',');}
function rgbToHex(rgb){try{var p=String(rgb).split(',').map(function(x){return parseInt(x,10);});return '#'+p.map(function(x){return x.toString(16).padStart(2,'0');}).join('');}catch(e){return '#18181b';}}
function toast(m){var t=$('#toast');if(!t)return;t.textContent=m;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(function(){t.classList.remove('show');},1500);}
function notify(){try{window.dispatchEvent(new CustomEvent('smile-tweaks',{detail:tweaks}));}catch(e){}}

function reserves(){
var m=Number(tweaks.layout.margin)||0,T=76,S=152,R=218,G=12;
var tVis=tweaks.layout.showTicker,tTop=tweaks.layout.tickerEdge==='top';
var meet=tweaks.stage.mode==='meet',strip=tweaks.meet.strip;
return{
t:m+((tVis&&tTop)?T+G:0)+((meet&&strip==='top')?S+G:0),
b:m+((tVis&&!tTop)?T+G:0)+((meet&&strip==='bottom')?S+G:0),
l:m+((meet&&strip==='left')?R+G:0),
r:m+((meet&&strip==='right')?R+G:0)
};
}

function applyTweaks(t,doLayout){
var r=document.documentElement.style;
r.setProperty('--c-accent',t.colors.accent);r.setProperty('--c-accent-rgb',hexToRgb(t.colors.accent));
r.setProperty('--c-bg',t.colors.bg);r.setProperty('--c-fg',t.colors.fg);r.setProperty('--c-muted',t.colors.muted);
r.setProperty('--c-faint',t.colors.faint);r.setProperty('--c-card-rgb',t.colors.cardRgb);r.setProperty('--c-card-alpha',t.colors.cardAlpha);
r.setProperty('--c-border',t.colors.border);r.setProperty('--c-on-accent',t.colors.onAccent);r.setProperty('--c-shadow',t.colors.shadow);
r.setProperty('--geom-radius',t.geometry.radius+'px');r.setProperty('--geom-blur',t.geometry.blur+'px');
r.setProperty('--geom-border',t.geometry.borderWidth+'px');r.setProperty('--geom-shadow',t.geometry.shadowDepth+'px');
r.setProperty('--anim-layout',t.geometry.animMs+'ms');
var res=reserves();
r.setProperty('--cluster-top',res.t+'px');
var b=document.body;
b.classList.toggle('hide-pip',!t.layout.showPip);b.classList.toggle('hide-wm',!t.layout.showWm);
b.classList.toggle('hide-cluster',!t.layout.showCluster);
b.classList.toggle('hide-trades',!t.layout.showTrades);b.classList.toggle('hide-chat',!t.layout.showChat);
b.classList.toggle('hide-ticker',!t.layout.showTicker);b.classList.toggle('hide-market',!t.layout.showMarket);
b.classList.toggle('hide-glow',!t.layout.showGlow);
b.classList.toggle('ticker-top',t.layout.tickerEdge==='top');b.classList.toggle('ticker-flipped',!!t.layout.tickerFlipped);
b.classList.toggle('mode-full',t.stage.mode==='full');b.classList.toggle('mode-meet',t.stage.mode==='meet');
b.classList.toggle('spot-on',!!t.spot.on);
var pip=$('#pip');if(pip)pip.style.setProperty('--pip-fit',t.layout.pipFit);
var mm=t.island.mat||'liquid';
var isl=$('#island');if(isl){isl.classList.toggle('mat-liquid',mm==='liquid');isl.classList.toggle('mat-obsidian',mm==='obsidian');isl.classList.toggle('mat-frosted',mm==='frosted');}
var pvc=$('.preview-card');if(pvc){pvc.classList.toggle('mat-liquid',mm==='liquid');pvc.classList.toggle('mat-obsidian',mm==='obsidian');pvc.classList.toggle('mat-frosted',mm==='frosted');}
var cp=$('#controlPanel');if(cp){cp.style.setProperty('--ctl-accent',t.colors.accent);var bg=hexToRgb(t.colors.bg).split(',').map(Number);var lum=.2126*bg[0]+.7152*bg[1]+.0722*bg[2];cp.classList.toggle('ctl-light',lum>140);}
if(doLayout&&!isControl){positionMeet();applyLayout(false);}
}

function prepPip(el){var w=Number(tweaks.layout.pipWidth)||376;el.style.width=w+'px';var c=el.querySelector('.pip-card');if(c){var ra={'16/9':9/16,'4/3':3/4,'1/1':1};c.style.height=Math.round(w*(ra[tweaks.layout.pipRatio]||9/16))+'px';}}
function prepSlot(el){el.style.width=(Number(tweaks.layout.widgetWidth)||380)+'px';}

function applyLayout(instant){
if(isControl)return;
if(instant){document.body.classList.add('no-layout-anim');clearTimeout(instantTimer);instantTimer=setTimeout(function(){document.body.classList.remove('no-layout-anim');},140);}
var vw=innerWidth,vh=innerHeight,res=reserves();
var defs=[
{id:'pip',sel:'#pip',pos:tweaks.layout.pipPos,scale:1,prep:prepPip},
{id:'slot-trades',sel:'#slot-trades',pos:tweaks.layout.tradesPos,scale:1,prep:prepSlot}];
defs.forEach(function(d){
var el=$(d.sel);if(!el)return;if(d.prep)d.prep(el);
var sc=d.scale||1,w=el.offsetWidth*sc,h=el.offsetHeight*sc;
var pos=String(d.pos||'tl'),v=pos.charAt(0),hz=pos.charAt(1),x=res.l,y=res.t;
if(hz==='l')x=res.l;else if(hz==='r')x=vw-res.r-w;else x=(vw-w)/2;
if(v==='t')y=res.t;else if(v==='b')y=vh-res.b-h;else y=(vh-h)/2;
var cp=(tweaks.layout.customPos||{})[d.id];
if(cp){x=cp.x;y=cp.y;}
x=Math.max(0,Math.min(x,Math.max(0,vw-w)));y=Math.max(0,Math.min(y,Math.max(0,vh-h)));
el.style.transform='translate('+Math.round(x)+'px,'+Math.round(y)+'px) scale('+sc+')';
});
}

function positionMeet(){
if(isControl||tweaks.stage.mode!=='meet')return;
var T=66,S=152,R=218;
var tVis=tweaks.layout.showTicker,tTop=tweaks.layout.tickerEdge==='top';
var strip=tweaks.meet.strip,main=$('#meetMain'),st=$('#meetStrip');
st.classList.toggle('vert',strip==='left'||strip==='right');
var mt={top:0,bottom:0,left:0,right:0};
if(strip==='bottom'){var sb=(tVis&&!tTop)?T:0;st.style.top='auto';st.style.bottom=sb+'px';st.style.left='0';st.style.right='0';st.style.height=S+'px';st.style.width='auto';}
if(strip==='top'){var sT=(tVis&&tTop)?T:0;st.style.bottom='auto';st.style.top=sT+'px';st.style.left='0';st.style.right='0';st.style.height=S+'px';st.style.width='auto';}
if(strip==='left'){st.style.top=(tVis&&tTop)?T+'px':'0';st.style.bottom=(tVis&&!tTop)?T+'px':'0';st.style.left='0';st.style.right='auto';st.style.width=R+'px';st.style.height='auto';}
if(strip==='right'){st.style.top=(tVis&&tTop)?T+'px':'0';st.style.bottom=(tVis&&!tTop)?T+'px':'0';st.style.right='0';st.style.left='auto';st.style.width=R+'px';st.style.height='auto';}
main.style.top=mt.top+'px';main.style.bottom=mt.bottom+'px';main.style.left=mt.left+'px';main.style.right=mt.right+'px';
}

function themesEqual(a,b){var ck=['accent','bg','cardRgb','cardAlpha','border','fg','muted','faint','onAccent','shadow'],gk=['radius','blur','borderWidth','shadowDepth','animMs'];return ck.every(function(k){return a.colors[k]===b.colors[k];})&&gk.every(function(k){return a.geometry[k]===b.geometry[k];});}
function updatePresetActive(){if(!isControl)return;$$('.presets button').forEach(function(btn){var p=THEME_PRESETS[btn.dataset.preset];btn.classList.toggle('active',!!p&&themesEqual(p,tweaks));});}

function broadcast(instant){
try{localStorage.setItem(TWEAK_STORE,JSON.stringify(tweaks));}catch(e){}
if(instant){document.body.classList.add('no-layout-anim');clearTimeout(instantTimer);instantTimer=setTimeout(function(){document.body.classList.remove('no-layout-anim');},140);}
applyTweaks(tweaks,!isControl);
try{channel.postMessage(tweaks);}catch(e){}
updatePresetActive();notify();
}
channel.onmessage=function(e){
var m=e.data;
if(m&&m.__island){fireIsland(m.__island);return;}
if(m&&m.__trade&&window.__tradeCmd){window.__tradeCmd(m.__trade);return;}
if(m&&m.__ann&&window.CAP){window.CAP.ann=m.__ann;window.CAP.annUntil=Date.now()+20000;return;}
tweaks=mergeDeep(defaultTweaks,m||{});try{localStorage.setItem(TWEAK_STORE,JSON.stringify(tweaks));}catch(err){}
applyTweaks(tweaks,!isControl);if(isControl)syncControlUI();notify();
};
window.addEventListener('storage',function(e){if(e.key!==TWEAK_STORE||!e.newValue)return;try{var inc=JSON.parse(e.newValue);if(JSON.stringify(inc)!==JSON.stringify(tweaks)){tweaks=mergeDeep(defaultTweaks,inc);applyTweaks(tweaks,!isControl);if(isControl)syncControlUI();notify();}}catch(err){}});
window.addEventListener('resize',function(){if(isControl)return;document.body.classList.add('no-layout-anim');clearTimeout(resizeTimer);resizeTimer=setTimeout(function(){positionMeet();applyLayout(true);document.body.classList.remove('no-layout-anim');},120);});

function buildLayers(){
var c=$('#layers');if(!c)return;c.innerHTML='';
LAYERS.forEach(function(cfg){
var layer=document.createElement('div');layer.className='layer';
var eye=document.createElement('button');eye.className='eye';eye.innerHTML=EYE_OPEN+EYE_CLOSED;
if(cfg.modeKey){eye.dataset.mode=cfg.modeKey;eye.addEventListener('click',function(){tweaks.stage.mode=(tweaks.stage.mode===cfg.modeKey)?'widgets':cfg.modeKey;syncEyes();broadcast(false);});}
else{eye.dataset.eye=cfg.showKey;eye.addEventListener('click',function(){tweaks.layout[cfg.showKey]=!tweaks.layout[cfg.showKey];syncEyes();broadcast(false);});}
var name=document.createElement('div');name.className='layer-name';name.textContent=cfg.name;
var controls=document.createElement('div');controls.className='layer-controls';
if(cfg.posKey){var g=document.createElement('div');g.className='pos-grid';g.dataset.layout=cfg.posKey;controls.appendChild(g);}
else if(cfg.ticker){controls.innerHTML='<div class="seg" data-seg="tickerEdge"><button data-val="top">Top</button><button data-val="bottom">Bottom</button></div><button class="mini-btn" data-flip>Flip</button>';}
else{var n=document.createElement('span');n.className='layer-note';n.textContent=cfg.modeKey?'stage':'global';controls.appendChild(n);}
layer.appendChild(eye);layer.appendChild(name);layer.appendChild(controls);c.appendChild(layer);
});
}
function buildGrids(){
var P=['tl','tc','tr','ml','mc','mr','bl','bc','br'];
$$('.pos-grid').forEach(function(g){g.innerHTML='';P.forEach(function(p){var b=document.createElement('button');b.dataset.pos=p;b.title=p.toUpperCase();b.addEventListener('click',function(){tweaks.layout[g.dataset.layout]=p;syncGrids();broadcast(false);});g.appendChild(b);});});
}
function bindSegs(){
$$('.seg').forEach(function(seg){
seg.querySelectorAll('button').forEach(function(btn){
btn.addEventListener('click',function(){
var kind=seg.dataset.seg,v=btn.dataset.val;
if(kind==='tickerEdge')tweaks.layout.tickerEdge=v;
if(kind==='stripEdge')tweaks.meet.strip=v;
if(kind==='stageMode')tweaks.stage.mode=v;
if(kind==='islandMat')tweaks.island.mat=v;
if(kind==='plats'){var ix=tweaks.cap.plats.indexOf(v);if(ix>-1)tweaks.cap.plats.splice(ix,1);else tweaks.cap.plats.push(v);}
syncSegs();syncEyes();broadcast(false);
});});
});
var flip=$('.mini-btn[data-flip]');
if(flip)flip.addEventListener('click',function(){tweaks.layout.tickerFlipped=!tweaks.layout.tickerFlipped;syncSegs();broadcast(false);});
}
function syncSegs(){
$$('.seg').forEach(function(seg){
var kind=seg.dataset.seg,cur=kind==='tickerEdge'?tweaks.layout.tickerEdge:kind==='stripEdge'?tweaks.meet.strip:kind==='islandMat'?tweaks.island.mat:tweaks.stage.mode;
seg.querySelectorAll('button').forEach(function(b){b.classList.toggle('active',kind==='plats'?(tweaks.cap.plats.indexOf(b.dataset.val)>-1):(b.dataset.val===cur));});
});
var flip=$('.mini-btn[data-flip]');if(flip)flip.classList.toggle('active',!!tweaks.layout.tickerFlipped);
}
function syncEyes(){
$$('.eye[data-eye]').forEach(function(btn){var v=!!tweaks.layout[btn.dataset.eye];btn.classList.toggle('off',!v);var l=btn.closest('.layer');if(l)l.classList.toggle('hidden-layer',!v);});
$$('.eye[data-mode]').forEach(function(btn){var on=tweaks.stage.mode===btn.dataset.mode;btn.classList.toggle('off',!on);var l=btn.closest('.layer');if(l)l.classList.toggle('hidden-layer',!on);});
}
function syncGrids(){$$('.pos-grid').forEach(function(g){var v=tweaks.layout[g.dataset.layout];g.querySelectorAll('button').forEach(function(b){b.classList.toggle('active',b.dataset.pos===v);});});}

function populateCameras(){
var sel=$('#ctrl-camera');if(!sel)return;
sel.innerHTML='<option value="">Auto / Default</option>';
if(!navigator.mediaDevices||!navigator.mediaDevices.enumerateDevices)return;
navigator.mediaDevices.enumerateDevices().then(function(dev){
var cams=dev.filter(function(d){return d.kind==='videoinput';});
sel.innerHTML='<option value="">Auto / Default</option>';
cams.forEach(function(d,i){var o=document.createElement('option');o.value=d.deviceId||('index:'+i);o.textContent=d.label||('Camera '+(i+1));sel.appendChild(o);});
if(tweaks.camera.deviceId){var ex=false;$$('#ctrl-camera option').forEach(function(o){if(o.value===tweaks.camera.deviceId)ex=true;});if(!ex){var o2=document.createElement('option');o2.value=tweaks.camera.deviceId;o2.textContent='Saved camera';sel.appendChild(o2);}sel.value=tweaks.camera.deviceId;}
}).catch(function(){});
}

function buildParticipants(){
var list=$('#pList');if(!list)return;list.innerHTML='';
var total=Math.min(9,Math.max(2,1+(tweaks.meet.guests|0)));
for(var i=0;i<total;i++){
(function(i){
var row=document.createElement('div');row.className='p-row';row.dataset.p=i;
row.innerHTML='<span class="sw" style="background:'+SWATCH[i]+'"></span><span class="pn">'+NAMES[i]+'</span><span class="talk"></span><button class="pbtn" data-act="raise" title="Raise hand"><svg viewBox="0 0 24 24"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12m0-6.5v-2a1.5 1.5 0 0 1 3 0V12m0-5.5a1.5 1.5 0 0 1 3 0V12m0-3.5a1.5 1.5 0 0 1 3 0V16a6 6 0 0 1-6 6h-2c-2.8 0-4.8-1.5-6.2-3.9L4.3 14a1.7 1.7 0 0 1 3-1.6l.7 1.1"/></svg></button><button class="pbtn" data-act="mute" title="Mute"><svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3ZM19 10v1a7 7 0 0 1-14 0v-1M12 18v4"/></svg></button><button class="pbtn" data-act="pin" title="Pin to main"><svg viewBox="0 0 24 24"><path d="M12 17v5M9 3h6l1 7 2.5 2.5H5.5L8 10 9 3Z"/></svg></button>';
row.querySelectorAll('.pbtn').forEach(function(btn){
btn.addEventListener('click',function(){
var act=btn.dataset.act;
if(act==='pin'){tweaks.meet.pinned=(tweaks.meet.pinned===i)?-1:i;broadcast(false);syncParticipants();}
if(act==='mute'){tweaks.meet.muted[i]=!tweaks.meet.muted[i];broadcast(false);syncParticipants();}
if(act==='raise'){try{meetChan.postMessage({type:'cmd',cmd:'raise',i:i,v:!btn.classList.contains('on')});}catch(e){}btn.classList.toggle('on');}
});
});
list.appendChild(row);
})(i);
}
}
function syncParticipants(){
if(!isControl)return;
buildParticipants();
$$('#pList .p-row').forEach(function(row){
var i=+row.dataset.p;
row.classList.toggle('main',(window.__lastActive||0)===i);
row.querySelector('[data-act="pin"]').classList.toggle('on',tweaks.meet.pinned===i);
row.querySelector('[data-act="mute"]').classList.toggle('on',!!tweaks.meet.muted[i]);
});
$('#ctrl-guests').value=1+(tweaks.meet.guests|0);
$('#val-guests').textContent=1+(tweaks.meet.guests|0);
$('#ctrl-autospeak').checked=!!tweaks.meet.autoSpeaker;
$('#ctrl-mic').checked=!!tweaks.meet.mic;
$('#ctrl-edit').checked=!!tweaks.edit.on;
$('#ctrl-cap-goal').checked=!!tweaks.cap.goal;
$('#ctrl-cap-chat').checked=!!tweaks.cap.chats;
var ch=$('#ctrl-cap-hold');if(ch){ch.value=tweaks.cap.hold||10;$('#val-cap-hold').textContent=(tweaks.cap.hold||10)+'s';}
$('#spot-text').value=tweaks.spot.text||'';
$('#spot-toggle').classList.toggle('active',!!tweaks.spot.on);
}
meetChan.onmessage=function(e){
var m=e.data||{};
if(isControl&&m.type==='live'){
window.__lastActive=m.active;
$$('#pList .p-row').forEach(function(row){
var i=+row.dataset.p;
row.classList.toggle('main',m.active===i);
row.querySelector('.talk').classList.toggle('on',(m.voices[i]||0)>.45);
});
}
if(!isControl&&m.type==='cmd'&&m.cmd==='raise'){raised[m.i]=m.v?1:0;if(m.v)raisePromote=m.i;}
};

function syncControlUI(){
if(!isControl)return;
$('#ctrl-accent').value=tweaks.colors.accent;$('#ctrl-bg').value=tweaks.colors.bg;
$('#ctrl-card-rgb').value=rgbToHex(tweaks.colors.cardRgb);$('#ctrl-border-color').value=tweaks.colors.border;
$('#ctrl-fg').value=tweaks.colors.fg;$('#ctrl-muted').value=tweaks.colors.muted;$('#ctrl-faint').value=tweaks.colors.faint;$('#ctrl-on-accent').value=tweaks.colors.onAccent;
$('#ctrl-blur').value=tweaks.geometry.blur;$('#val-blur').textContent=tweaks.geometry.blur+'px';
$('#ctrl-radius').value=tweaks.geometry.radius;$('#val-radius').textContent=tweaks.geometry.radius+'px';
$('#ctrl-card-alpha').value=tweaks.colors.cardAlpha;$('#val-card-alpha').textContent=Math.round(tweaks.colors.cardAlpha*100)+'%';
$('#ctrl-border-width').value=tweaks.geometry.borderWidth;$('#val-border-width').textContent=tweaks.geometry.borderWidth+'px';
$('#ctrl-shadow').value=tweaks.geometry.shadowDepth;$('#val-shadow').textContent=tweaks.geometry.shadowDepth+'px';
$('#ctrl-anim').value=tweaks.geometry.animMs;$('#val-anim').textContent=tweaks.geometry.animMs+'ms';
$('#ctrl-margin').value=tweaks.layout.margin;$('#val-margin').textContent=tweaks.layout.margin+'px';
$('#ctrl-widget-width').value=tweaks.layout.widgetWidth;$('#val-widget-width').textContent=tweaks.layout.widgetWidth+'px';
$('#ctrl-pip-width').value=tweaks.layout.pipWidth;$('#val-pip-width').textContent=tweaks.layout.pipWidth+'px';
$('#ctrl-pip-ratio').value=tweaks.layout.pipRatio;$('#ctrl-pip-fit').value=tweaks.layout.pipFit;
$('#ctrl-ticker-speed').value=tweaks.layout.tickerSpeed;$('#val-ticker-speed').textContent=tweaks.layout.tickerSpeed+'px/s';
var cs=$('#ctrl-camera');if(cs)cs.value=tweaks.camera.deviceId||'';
var cm=$('#ctrl-camera-mirror');if(cm)cm.checked=!!tweaks.camera.mirror;
syncEyes();syncGrids();syncSegs();syncParticipants();updatePresetActive();
}

function initControl(){
buildLayers();buildGrids();bindSegs();populateCameras();syncControlUI();
function on(id,ev,fn){var el=$(id);if(el)el.addEventListener(ev,fn);return el;}
function rng(id,vid,set,fmt){on('#'+id,'input',function(e){var v=+e.target.value;set(v);var vv=$('#'+vid);if(vv)vv.textContent=fmt?fmt(v):v;broadcast(true);});}
$$('.presets button').forEach(function(btn){btn.addEventListener('click',function(){var p=THEME_PRESETS[btn.dataset.preset];if(!p)return;tweaks.colors=mergeDeep(defaultTweaks.colors,p.colors);tweaks.geometry=mergeDeep(defaultTweaks.geometry,p.geometry);syncControlUI();broadcast(false);toast('Theme applied');});});
$$('.scene-btn').forEach(function(btn){btn.addEventListener('click',function(){var s=SCENE_PRESETS[btn.dataset.scene];if(!s)return;if(s.stage)tweaks.stage=mergeDeep(tweaks.stage,s.stage);if(s.meet)tweaks.meet=mergeDeep(tweaks.meet,s.meet);if(s.layout){tweaks.layout=mergeDeep(tweaks.layout,s.layout);var vw=innerWidth||1920;if(s.layout.pipWidth>=1000)tweaks.layout.pipWidth=Math.max(480,Math.min(1200,Math.round(vw*0.55)));else if(s.layout.pipWidth>400)tweaks.layout.pipWidth=Math.max(300,Math.min(640,Math.round(vw*0.25)));if(s.layout.widgetWidth>=380)tweaks.layout.widgetWidth=Math.max(300,Math.min(560,Math.round(vw*0.24)));tweaks.layout.customPos={};}syncControlUI();broadcast(false);toast('Scene applied');});});
on('#openViewer','click',function(){window.open(location.href.split('?')[0],'_blank');});
on('#copyUrl','click',function(){var u=location.href.split('?')[0];if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(u).then(function(){toast('OBS URL copied');}).catch(function(){prompt('Copy OBS URL',u);});}else prompt('Copy OBS URL',u);});
on('#resetTweaks','click',function(){localStorage.removeItem(TWEAK_STORE);location.reload();});
rng('ctrl-blur','val-blur',function(v){tweaks.geometry.blur=v;},function(v){return v+'px';});
rng('ctrl-radius','val-radius',function(v){tweaks.geometry.radius=v;},function(v){return v+'px';});
rng('ctrl-card-alpha','val-card-alpha',function(v){tweaks.colors.cardAlpha=v;},function(v){return Math.round(v*100)+'%';});
rng('ctrl-border-width','val-border-width',function(v){tweaks.geometry.borderWidth=v;},function(v){return v+'px';});
rng('ctrl-shadow','val-shadow',function(v){tweaks.geometry.shadowDepth=v;},function(v){return v+'px';});
rng('ctrl-anim','val-anim',function(v){tweaks.geometry.animMs=v;},function(v){return v+'ms';});
rng('ctrl-margin','val-margin',function(v){tweaks.layout.margin=v;},function(v){return v+'px';});
rng('ctrl-widget-width','val-widget-width',function(v){tweaks.layout.widgetWidth=v;},function(v){return v+'px';});
rng('ctrl-pip-width','val-pip-width',function(v){tweaks.layout.pipWidth=v;},function(v){return v+'px';});
rng('ctrl-ticker-speed','val-ticker-speed',function(v){tweaks.layout.tickerSpeed=v;},function(v){return v+'px/s';});
rng('ctrl-cap-hold','val-cap-hold',function(v){tweaks.cap.hold=v;},function(v){return v+'s';});
[['#ctrl-accent',function(v){tweaks.colors.accent=v;}],['#ctrl-bg',function(v){tweaks.colors.bg=v;}],['#ctrl-card-rgb',function(v){tweaks.colors.cardRgb=hexToRgb(v);}],['#ctrl-border-color',function(v){tweaks.colors.border=v;}],['#ctrl-fg',function(v){tweaks.colors.fg=v;}],['#ctrl-muted',function(v){tweaks.colors.muted=v;}],['#ctrl-faint',function(v){tweaks.colors.faint=v;}],['#ctrl-on-accent',function(v){tweaks.colors.onAccent=v;}]].forEach(function(c){on(c[0],'input',function(e){c[1](e.target.value);broadcast(false);});});
on('#ctrl-pip-ratio','change',function(e){tweaks.layout.pipRatio=e.target.value;broadcast(false);});
on('#ctrl-pip-fit','change',function(e){tweaks.layout.pipFit=e.target.value;broadcast(false);});
on('#ctrl-camera','change',function(e){tweaks.camera.deviceId=e.target.value;broadcast(false);toast('Camera updated');});
on('#ctrl-camera-mirror','change',function(e){tweaks.camera.mirror=e.target.checked;broadcast(false);});
on('#ctrl-camera-scan','click',function(){populateCameras();toast('Scanning');});
on('#ctrl-guests','input',function(e){tweaks.meet.guests=(+e.target.value)-1;$('#val-guests').textContent=+e.target.value;syncParticipants();broadcast(false);});
on('#ctrl-autospeak','change',function(e){tweaks.meet.autoSpeaker=e.target.checked;broadcast(false);});
on('#ctrl-mic','change',function(e){tweaks.meet.mic=e.target.checked;broadcast(false);});
on('#ctrl-edit','change',function(e){tweaks.edit.on=e.target.checked;broadcast(false);toast(e.target.checked?'Edit mode on — drag widgets in viewer':'Edit mode off');});
on('#ctrl-clear-pos','click',function(){tweaks.layout.customPos={};broadcast(false);toast('Custom positions cleared');});
on('#ctrl-cap-goal','change',function(e){tweaks.cap.goal=e.target.checked;broadcast(false);});
on('#ctrl-cap-chat','change',function(e){tweaks.cap.chats=e.target.checked;broadcast(false);});
var ANN_SAMPLES=['Giveaway at 500 followers!','Next: London session breakdown','Q&A after this trade closes','Drop a 🙂 if you are new!'];var annI=0;
on('#isl-test-ann','click',function(){try{channel.postMessage({__ann:ANN_SAMPLES[annI++%ANN_SAMPLES.length]});}catch(e){}});
on('#spot-toggle','click',function(){tweaks.spot.on=!tweaks.spot.on;tweaks.spot.text=$('#spot-text').value||tweaks.spot.text;syncControlUI();broadcast(false);});
on('#spot-text','input',function(e){if(tweaks.spot.on){tweaks.spot.text=e.target.value;broadcast(false);}});
function postIsland(ev){try{channel.postMessage({__island:ev});}catch(e){}}
function postTrade(c){try{channel.postMessage({__trade:c});}catch(e){}}
on('#isl-test-thanks','click',function(){postIsland({type:'superthanks',user:'Kiprop',amount:'KES 500',msg:'Thanks for the clean analysis!'});});
on('#isl-test-chat','click',function(){postIsland({type:'superchat',user:'Amara',amount:'$10',msg:'What is your risk per trade?'});});
on('#isl-test-follow','click',function(){postIsland({type:'follow',user:'Brian',msg:'just joined the Smile Squad'});});
on('#isl-test-sub','click',function(){postIsland({type:'sub',user:'Chloe',amount:'1 month',msg:'is now subscribed'});});
on('#isl-test-sched','click',function(){postIsland({type:'schedule',msg:'London session opens in 5 minutes'});});
on('#isl-test-open','click',function(){postTrade('open');});
on('#isl-test-close','click',function(){postTrade('close');});
on('#isl-test-tp','click',function(){postTrade('tp');});
on('#isl-test-sl','click',function(){postTrade('sl');});
}
/* ═══ DYNAMIC ISLAND ENGINE (viewer) ═══ */
var islQueue=[],islBusy=false;
function fireIsland(ev){islQueue.push(ev);islPump();}
function islPump(){
if(islBusy||!islQueue.length)return;
var ev=islQueue.shift();
var ico=$('#islIco'),who=$('#islWho'),msg=$('#islMsg'),amt=$('#islAmt');
var map={superthanks:['<svg viewBox="0 0 24 24"><path d="M12 21s-7-4.6-9.5-9C.7 8.6 2.6 5 6 5c2 0 3.2 1 4 2.2C10.8 6 12 5 14 5c3.4 0 5.3 3.6 3.5 7-2.5 4.4-9.5 9-9.5 9Z"/></svg>','Super Thanks'],superchat:['<svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-8 8c-.9 0-1.8-.1-2.6-.4L4 21l1.4-4.4A8 8 0 1 1 21 12Z"/></svg>','Super Chat'],follow:['<svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6"/></svg>','New Follower'],sub:['<svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/></svg>','New Sub'],schedule:['<svg viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 9h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/></svg>','Schedule'],trade:['<svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"/></svg>','Signal'],close:['<svg viewBox="0 0 24 24"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1M22 4 12 14l-3-3"/></svg>','Trade Closed']};
var m=map[ev.type]||['<svg viewBox="0 0 24 24"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>','Alert'];
var tint={superthanks:'255,193,7',superchat:'14,203,129',follow:'0,104,255',sub:'147,51,234',schedule:'255,138,0',trade:'14,203,129',close:'255,255,255'}[ev.type]||'255,255,255';
if(ico){ico.style.background='rgba('+tint+',.16)';ico.style.boxShadow='0 0 0 1px rgba('+tint+',.4) inset';ico.innerHTML=m[0];ico.style.animation='none';void ico.offsetWidth;ico.style.animation='';}
if(window.smileMood){var md={superthanks:'celebrate',sub:'bounce',follow:'nod',superchat:'look',schedule:'look',trade:'nod'}[ev.type]||(ev.type==='close'?(String(ev.amount||'').indexOf('+')===0?'celebrate':'shake'):'');if(md)smileMood(md,900);}
if(who)who.textContent=(ev.user?ev.user+' · ':'')+m[1];
if(msg)msg.textContent=ev.msg||'';
if(amt){if(ev.amount){amt.style.display='';amt.textContent=ev.amount;}else amt.style.display='none';}
var isl=$('#island');
isl.classList.remove('settle');void isl.offsetWidth;isl.classList.add('settle');
isl.dataset.view='alert';islBusy=true;
setTimeout(function(){isl.dataset.view='compact';islBusy=false;setTimeout(islPump,420);},5200);
}
function initIsland(){
var isl=$('#island');
isl.addEventListener('mouseenter',function(){if(!islBusy)isl.dataset.view='expand';});
isl.addEventListener('mouseleave',function(){if(!islBusy)isl.dataset.view='compact';setTimeout(islPump,300);});
isl.addEventListener('click',function(){if(islBusy)return;isl.dataset.view=isl.dataset.view==='expand'?'compact':'expand';});
var notified={};
setInterval(function(){
var now=new Date(),uH=now.getUTCHours(),uM=now.getUTCMinutes();
TZS.forEach(function(t){
var r=RANGES[t[0]];if(!r)return;
var mu=r[0]*60-(uH*60+uM);
var key=t[0]+'-'+now.getUTCDate();
if(mu>=0&&mu<=5&&!notified[key]){notified[key]=1;fireIsland({type:'schedule',msg:t[1]+' session opens in '+mu+' min'});}
});
},20000);
}
function nextScheduleLine(){
var now=new Date(),uH=now.getUTCHours(),uM=now.getUTCMinutes(),best=null;
TZS.forEach(function(t){var r=RANGES[t[0]];if(!r)return;var mu=r[0]*60-(uH*60+uM);if(mu<0)mu+=1440;if(!best||mu<best.mu)best={mu:mu,name:t[1]};});
var el=$('#islNext');if(el&&best)el.innerHTML='▸ next: <b>'+best.name+'</b> opens in '+best.mu+'m';
}

function esc2(s){return String(s).replace(/[&<>"']/g,function(ch){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];});}
var drawerTimer=null,drawerOpen=false,chatPending=0;
function showChatDrawer(c){
if(!c||!tweaks.cap.chats||!tweaks.layout.showChat)return;
var d=$('#capDrawer');if(!d)return;
var pl={yt:['▶','#f00'],fb:['f','#1877f2'],tw:['◉','#9146ff']}[c.plat]||['•','#888'];
var pb=$('#drwPlat');if(pb){pb.textContent=pl[0];pb.style.background=pl[1];}
var u=$('#drwUser');if(u)u.innerHTML=esc2(c.user)+' <i class="drw-at">@'+String(c.user).toLowerCase().replace(/[^a-z0-9_]/g,'')+'</i>';
var tx=$('#drwTxt');if(tx)tx.textContent=c.text||'';
if(drawerOpen){chatPending++;var mo=$('#drwMore');if(mo){mo.style.display='';mo.textContent='+'+chatPending+' more';}}
else{chatPending=0;var mo2=$('#drwMore');if(mo2)mo2.style.display='none';d.classList.add('open');drawerOpen=true;}
clearTimeout(drawerTimer);
drawerTimer=setTimeout(function(){d.classList.remove('open');drawerOpen=false;},Math.max(4,(tweaks.cap.hold||10))*1000);
}

/* ═══ TRADES ENGINE ═══ */
function initTrades(){
var TR={trades:[],spot:null,count:0,sim:true,lastClose:0,lastChatP:0};
var CAP={goal:null,chat:null,ann:'',annUntil:0};
window.CAP=CAP;
function ps(m){return m.indexOf('XAU')===0?0.1:(m.indexOf('BTC')===0?1:0.0001);}
function pipsOf(t,px){var d=((px!=null?px:t.now)-t.entry)/ps(t.market);return t.side==='SHORT'?-d:d;}
function openCount(){return TR.trades.filter(function(t){return t.status==='open';}).length;}
function openSim(){
var mk=['EUR/USD','XAU/USD','BTC/USD','GBP/USD'][Math.floor(Math.random()*4)];
var base=mk==='EUR/USD'?1.0850:mk==='XAU/USD'?2384:mk==='BTC/USD'?67240:1.2700;
var side=Math.random()<.5?'LONG':'SHORT',dir=side==='LONG'?1:-1;
var entry=base*(1+(Math.random()-.5)*.002);
var tpP=40+Math.random()*80,slP=20+Math.random()*40;
TR.count++;
var t={id:TR.count,market:mk,side:side,entry:entry,tp:entry+dir*tpP*ps(mk),sl:entry-dir*slP*ps(mk),status:'open',tpP:tpP,slP:slP,now:entry};
TR.trades.push(t);TR.spot=t;
fireIsland({type:'trade',user:'Signal #'+t.id,msg:mk+' '+side+' · TP '+tpP.toFixed(0)+' / SL '+slP.toFixed(0)});
}
function closeTrade(t,reason,px){
if(!t||t.status!=='open')return;
t.status='closed';t.reason=reason;t.result=pipsOf(t,px!=null?px:t.now);
if(TR.spot===t)fireIsland({type:'close',user:'Trade #'+t.id+' '+reason.toUpperCase(),msg:t.market+' '+t.side,amount:(t.result>=0?'+':'')+t.result.toFixed(0)+' pips'});
TR.lastClose=Date.now();
}
function cycleSpot(){var o=TR.trades.filter(function(t){return t.status==='open';});if(o.length<2)return;var i=o.indexOf(TR.spot);TR.spot=o[(i+1)%o.length];render();}
window.__tradeCmd=function(c){
var t=TR.spot;
if(c==='open')openSim();
if(c==='close')closeTrade(t,'manual');
if(c==='tp'&&t)closeTrade(t,'tp',t.tp);
if(c==='sl'&&t)closeTrade(t,'sl',t.sl);
if(c==='next')cycleSpot();
};
window.__tradesFeed=function(list){
if(!list||!list.length)return;
TR.sim=false;
list.forEach(function(inc){
var ex=null;TR.trades.forEach(function(x){if(x.id===inc.id)ex=x;});
if(ex){
if(inc.now!=null)ex.now=inc.now;
if(inc.pips!=null)ex.pips=inc.pips;
if(inc.status==='closed'&&ex.status==='open'){ex.status='closed';ex.reason=inc.closeReason||'manual';ex.result=inc.pips||0;fireIsland({type:'close',user:'Trade #'+ex.id+' closed',msg:ex.market+' '+ex.side,amount:((ex.result||0)>=0?'+':'')+(ex.result||0)+' pips'});}
}else{
TR.trades.push(inc);
if(inc.status==='open')fireIsland({type:'trade',user:'Signal #'+inc.id,msg:inc.market+' '+inc.side});
}
});
var o=TR.trades.filter(function(t){return t.status==='open';});
TR.spot=o.length?o[o.length-1]:null;
};
var CHAT_N=['Kip','Amara','Brian','Chloe','David','Elif','Farah','Gio','Kito','Lena','Musa','Nia'];
var CHAT_T=['this ladder is so clean','how do I join the squad?','risk management on point','that bull is fighting','signal copied, ty!','first stream here, loving it','KES gang','obsidian glass looks insane'];
setInterval(function(){
var now=Date.now();
if(TR.sim){
TR.trades.filter(function(t){return t.status==='open';}).forEach(function(t){
t.now*=(1+(Math.random()-.5)*.0009);
var p=pipsOf(t,t.now);
if(p>=t.tpP)closeTrade(t,'tp');
else if(p<=-t.slP)closeTrade(t,'sl');
});
if(openCount()<3&&now-TR.lastClose>6000&&Math.random()<.25)openSim();
if(!TR.spot||TR.spot.status!=='open'){var o=TR.trades.filter(function(t){return t.status==='open';});TR.spot=o.length?o[o.length-1]:null;}
if(!CAP.goal){CAP.goal={c:380+Math.floor(Math.random()*120),t:1000};}
else if(CAP.goal.c<CAP.goal.t&&Math.random()<.35)CAP.goal.c=Math.min(CAP.goal.t,CAP.goal.c+1);
}
if(tweaks.cap.chats&&tweaks.cap.plats.length&&now-TR.lastChatP>9000+Math.random()*6000){
TR.lastChatP=now;
CAP.chat={plat:tweaks.cap.plats[Math.floor(Math.random()*tweaks.cap.plats.length)],user:CHAT_N[Math.floor(Math.random()*CHAT_N.length)],text:CHAT_T[Math.floor(Math.random()*CHAT_T.length)]};
showChatDrawer(CAP.chat);
}
render();renderCap(now);
},700);
function fmt(v){return v>=1000?v.toFixed(1):v.toFixed(4);}
function render(){
var t=TR.spot,chip=$('#islTrd');
if(!t){
if(chip){$('#islTrdNum').textContent='—';$('#islTrdPips').textContent='flat';chip.classList.remove('down');}
var s0=$('#itStatus');if(s0){s0.textContent='FLAT';s0.className='it-status closed';}
renderTrk();return;
}
var p=t.pips!=null&&!TR.sim?t.pips:pipsOf(t,t.now);
if(chip){chip.classList.toggle('down',p<0);$('#islTrdNum').textContent='#'+t.id;$('#islTrdPips').textContent=(p>=0?'+':'')+p.toFixed(1);}
var e=$('#itNum');if(e)e.textContent='TRADE #'+t.id+' · '+openCount()+' OPEN';
var m=$('#itMkt');if(m)m.textContent=t.market;
var sd=$('#itSide');if(sd){sd.textContent=t.side;sd.className='it-side '+(t.side==='LONG'?'long':'short');}
var st=$('#itStatus');if(st){st.textContent=t.status==='open'?'RUNNING':(t.reason||'CLOSED').toUpperCase();st.className='it-status'+(t.status==='open'?'':' closed');}
var a=$('#itEntry');if(a)a.textContent=fmt(t.entry);
var n=$('#itNow');if(n)n.textContent=fmt(t.now);
var tp=$('#itTp');if(tp)tp.textContent=fmt(t.tp);
var sl=$('#itSl');if(sl)sl.textContent=fmt(t.sl);
var rr=$('#itRr');if(rr)rr.textContent='1:'+(t.tpP/t.slP).toFixed(1);
var pp=$('#itPips');if(pp){pp.textContent=(p>=0?'+':'')+p.toFixed(1);pp.classList.toggle('down',p<0);}
var ar=$('#itArrow');
if(ar){var pct=Math.abs(p-(t._prevP||0))*ps(t.market)/Math.max(1e-9,t.now)*100;t._prevP=p;ar.className='it-arrow'+(p<0?' down':'')+(pct>.03?' mag3':(pct>.012?' mag2':''));}
var lad=document.querySelector('.it-ladder');
if(lad){lad.classList.toggle('win',p>=0);lad.classList.toggle('lose',p<0);}
var dot=$('#itDot');
if(dot){var span=(t.tp-t.sl)||1;dot.style.left=Math.max(4,Math.min(96,((t.now-t.sl)/span)*100))+'%';}
renderTrk();
}
function renderTrk(){
var body=$('#trkBody');if(!body)return;
var opens=TR.trades.filter(function(t){return t.status==='open';}).reverse();
var closed=TR.trades.filter(function(t){return t.status==='closed';}).reverse().slice(0,2);
var html='';
if(!opens.length&&!closed.length)html='<div class="trk-empty">no open signals · waiting for feed</div>';
opens.forEach(function(t){
var p=t.pips!=null&&!TR.sim?t.pips:pipsOf(t,t.now);
var span=(t.tp-t.sl)||1,pos=Math.max(4,Math.min(96,((t.now-t.sl)/span)*100));
html+='<div class="trk-row'+(TR.spot===t?' spot':'')+'" data-id="'+t.id+'" style="cursor:pointer"><span class="tm">'+t.market+'</span><span class="ts2 '+t.side.toLowerCase()+'">'+t.side+'</span><span class="trk-lad"><i style="left:'+pos+'%"></i></span><span class="trk-pips" style="color:'+(p>=0?'var(--c-up)':'var(--c-down)')+'">'+(p>=0?'+':'')+p.toFixed(0)+'</span></div>';
});
closed.forEach(function(t){
html+='<div class="trk-row closed"><span class="tm">'+t.market+'</span><span class="ts2 '+t.side.toLowerCase()+'">'+t.side+'</span><span class="res" style="color:'+(t.reason==='sl'?'var(--c-down)':'var(--c-up)')+'">'+(t.reason||'').toUpperCase()+'</span><span class="trk-pips" style="color:'+((t.result||0)>=0?'var(--c-up)':'var(--c-down)')+'">'+((t.result||0)>=0?'+':'')+(t.result||0).toFixed(0)+'</span></div>';
});
body.innerHTML=html;
var tag=$('#trkTag');if(tag)tag.textContent=opens.length+' OPEN';
}
var sw=$('#islSwap');if(sw)sw.addEventListener('click',function(e){e.stopPropagation();cycleSpot();});
var tb=$('#trkBody');if(tb)tb.addEventListener('click',function(e){var r=e.target.closest('.trk-row[data-id]');if(!r)return;var id=+r.dataset.id;TR.trades.forEach(function(t){if(t.id===id&&t.status==='open')TR.spot=t;});render();});
var capIdx=0,capLast=0;
function renderCap(now){
if(now-capLast>6000){capLast=now;capIdx++;}
var items=['risk'];
if(tweaks.cap.goal&&CAP.goal)items.push('goal');
if(tweaks.cap.announce&&now<CAP.annUntil)items.push('ann');
var cur=items[capIdx%items.length];
['cdRisk','cdGoal','cdAnn'].forEach(function(id){var el=document.getElementById(id);if(el)el.classList.remove('on');});
var el=document.getElementById({risk:'cdRisk',goal:'cdGoal',ann:'cdAnn'}[cur]);
if(el)el.classList.add('on');
if(cur==='goal'&&CAP.goal){var g=$('#cdGoalTxt');if(g)g.textContent=CAP.goal.c.toLocaleString()+'/'+CAP.goal.t.toLocaleString();var f=$('#cdGoalFill');if(f)f.style.width=Math.min(100,CAP.goal.c/CAP.goal.t*100)+'%';}
if(cur==='ann'){var ax=$('#cdAnnTxt');if(ax)ax.textContent=CAP.ann;}
}
}
<style>.chat-drawer .drw-at{color:var(--c-faint);font-size:11px;font-weight:500;margin-left:6px;font-style:normal;}#island{backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);background:transparent;}
</style>

/* ═══ VIEWER ENGINE ═══ */
var raised={},raisePromote=-1;
function initViewer(){
var camStream=null,camBusy=false,obsConnected=false,streaming=false,recording=false;
var wsPort=q.get('wsport')||'4455',wsPass=q.get('wspass')||'';
var currentCamKey='';
var tiles=[],voices=[0,0,0,0,0,0,0,0,0],talkT=[0,0,0,0,0,0,0,0,0],active=0,lastSwitch=0;
var micStream=null,analyser=null,micData=null,hostLevel=0;

function buildTiles(){
var st=$('#meetStrip');st.innerHTML='';tiles=[];
for(var i=0;i<9;i++){
(function(i){
var t=document.createElement('div');t.className='tile';
t.innerHTML='<video autoplay playsinline muted></video><div class="tico hand"><span>✋</span></div><div class="tico mic"><span>🔇</span></div><span class="tag"><i class="tdot"></i>'+NAMES[i]+'</span>';
t.addEventListener('click',function(){tweaks.meet.pinned=(tweaks.meet.pinned===i)?-1:i;broadcast(false);});
st.appendChild(t);tiles.push(t);
})(i);
}
}
buildTiles();
initIsland();
initTrades();

function mirrorActive(){var p=q.get('mirror');if(p!==null)return p==='1';return !!tweaks.camera.mirror;}
function desiredCamKey(){return (tweaks.camera.deviceId||'auto')+'|'+(mirrorActive()?'1':'0');}
function attachAll(stream){
$('#camVideo').srcObject=stream;
$('#stageCamVideo').srcObject=stream;
$('#meetMainVideo').srcObject=stream;
tiles.forEach(function(t){t.querySelector('video').srcObject=stream;});
}
function chooseVideo(cams){
var video={width:{ideal:1920},height:{ideal:1080}},dev=tweaks.camera.deviceId;
if(dev){if(dev.indexOf('index:')===0){var i=parseInt(dev.slice(6),10);if(cams[i])video.deviceId={exact:cams[i].deviceId};}else video.deviceId={exact:dev};}
else{var p=parseInt(q.get('cam'),10);if(!isNaN(p)&&cams[p])video.deviceId={exact:cams[p].deviceId};}
return video;
}
function startCam(){
if(camStream||camBusy)return;camBusy=true;
var done=function(){camBusy=false;};
if(!navigator.mediaDevices){done();return;}
navigator.mediaDevices.enumerateDevices().then(function(d){return d.filter(function(x){return x.kind==='videoinput';});}).then(function(cams){
if(!cams.length)throw 0;
return navigator.mediaDevices.getUserMedia({audio:false,video:chooseVideo(cams)}).catch(function(){return navigator.mediaDevices.getUserMedia({audio:false,video:true});});
}).then(function(stream){
camStream=stream;attachAll(stream);
if(mirrorActive())$('#camVideo').classList.add('mirror');
document.body.classList.add('hascam');
var tg=$('#pipTagTxt');if(tg)tg.textContent='CAM · LIVE';
applyLayout(true);
}).catch(function(){}).then(done);
}
function stopCam(){if(camStream){camStream.getTracks().forEach(function(t){t.stop();});camStream=null;}document.body.classList.remove('hascam');}
function refreshCamera(){var k=desiredCamKey();if(k!==currentCamKey){currentCamKey=k;stopCam();startCam();}}
window.addEventListener('smile-tweaks',function(){refreshCamera();setupMic();});

function initEdit(){
function items(){return ['#pip','#slot-trades'].map(function(s){return $(s);}).filter(Boolean);}
function paint(){document.body.classList.toggle('edit',!!tweaks.edit.on);}
paint();
window.addEventListener('smile-tweaks',paint);
items().forEach(function(el){
var drag=null;
el.addEventListener('pointerdown',function(e){if(!tweaks.edit.on)return;drag={x:e.clientX,y:e.clientY};el.setPointerCapture(e.pointerId);e.preventDefault();});
el.addEventListener('pointermove',function(e){if(!drag)return;var r=el.getBoundingClientRect();var nx=r.left+(e.clientX-drag.x),ny=r.top+(e.clientY-drag.y);drag.x=e.clientX;drag.y=e.clientY;drag.nx=nx;drag.ny=ny;el.style.transform='translate('+Math.round(nx)+'px,'+Math.round(ny)+'px)';});
el.addEventListener('pointerup',function(){if(drag&&drag.nx!=null){tweaks.layout.customPos=tweaks.layout.customPos||{};tweaks.layout.customPos[el.id]={x:Math.round(drag.nx),y:Math.round(drag.ny)};broadcast(false);}drag=null;});
el.addEventListener('dblclick',function(){if(tweaks.edit.on){if(tweaks.layout.customPos&&tweaks.layout.customPos[el.id]){delete tweaks.layout.customPos[el.id];el.classList.remove('snapk');void el.offsetWidth;el.classList.add('snapk');broadcast(false);}}});
});
}
initEdit();

function setupMic(){
var want=tweaks.meet.mic;
if(want&&!micStream&&navigator.mediaDevices&&navigator.mediaDevices.getUserMedia){
navigator.mediaDevices.getUserMedia({audio:true}).then(function(s){
micStream=s;var ctx=new (window.AudioContext||window.webkitAudioContext)();
var src=ctx.createMediaStreamSource(s);analyser=ctx.createAnalyser();analyser.fftSize=512;
micData=new Uint8Array(analyser.fftSize);src.connect(analyser);
}).catch(function(){analyser=null;});
}
if(!want&&micStream){micStream.getTracks().forEach(function(t){t.stop();});micStream=null;analyser=null;}
}
setupMic();

setInterval(function(){
if(tweaks.stage.mode!=='meet')return;
var now=Date.now(),total=Math.min(9,1+(tweaks.meet.guests|0));
if(analyser){analyser.getByteTimeDomainData(micData);var s=0;for(var j=0;j<micData.length;j++){var v=(micData[j]-128)/128;s+=v*v;}hostLevel=Math.min(1,Math.sqrt(s/micData.length)*5);}
for(var i=0;i<9;i++){
if(i>=total){voices[i]=0;continue;}
var muted=!!tweaks.meet.muted[i];
if(i===0){voices[0]=analyser?hostLevel:Math.max(0,voices[0]-.06);if(!analyser&&!muted&&Math.random()<.02)voices[0]=.9;}
else{
if(!muted&&talkT[i]<=0&&Math.random()<.012)talkT[i]=1500+Math.random()*3000;
if(talkT[i]>0){talkT[i]-=120;voices[i]=Math.min(1,voices[i]+.25);}
else voices[i]=Math.max(0,voices[i]-.12);
if(muted)voices[i]=0;
}
}
if(raisePromote>=0&&tweaks.meet.pinned<0){active=raisePromote;raisePromote=-1;lastSwitch=now;}
if(tweaks.meet.autoSpeaker&&tweaks.meet.pinned<0){
var best=-1,bv=.45;
for(var k2=0;k2<total;k2++){if(voices[k2]>bv){bv=voices[k2];best=k2;}}
if(best>=0&&best!==active&&now-lastSwitch>1400){active=best;lastSwitch=now;}
}
renderMeet(total);
},120);
setInterval(function(){
if(tweaks.stage.mode!=='meet')return;
if(Math.random()<.02){var total=1+(tweaks.meet.guests|0);var g=1+Math.floor(Math.random()*Math.max(1,total-1));if(g<9&&!raised[g])raised[g]=Date.now()+5000+Math.random()*3000;}
var now=Date.now();for(var k in raised){if(raised[k]<now)delete raised[k];}
},800);
setInterval(function(){
if(tweaks.stage.mode==='meet'){
try{meetChan.postMessage({type:'live',active:currentActive(),voices:voices.map(function(v){return Math.round(v*100)/100;})});}catch(e){}
var act=currentActive(),isl=$('#island');
if(isl)isl.classList.toggle('speaking',voices[act]>.45);
}else{var isl2=$('#island');if(isl2)isl2.classList.remove('speaking');}
},400);

function currentActive(){return tweaks.meet.pinned>=0?tweaks.meet.pinned:active;}
function renderMeet(total){
var act=currentActive();
var mv=$('#meetMainVideo');
mv.style.filter=FILTERS[act];mv.style.objectPosition=CROPS[act];
$('#meetMainName').textContent=NAMES[act]+(tweaks.meet.pinned===act?' · pinned':'');
var mm=$('#meetMain');
mm.classList.toggle('speaking',voices[act]>.45);
mm.classList.toggle('muted',!!tweaks.meet.muted[act]);
mm.classList.toggle('raised',!!raised[act]);
tiles.forEach(function(t,i){
var show=i<total&&i!==act;
t.style.display=show?'':'none';
if(!show)return;
var v=t.querySelector('video');v.style.filter=FILTERS[i];v.style.objectPosition=CROPS[i];
t.classList.toggle('speaking',voices[i]>.45);
t.classList.toggle('muted',!!tweaks.meet.muted[i]);
t.classList.toggle('pinned',tweaks.meet.pinned===i);
t.classList.toggle('raised',!!raised[i]);
});
}

function b64(buf){var a='';new Uint8Array(buf).forEach(function(b){a+=String.fromCharCode(b);});return btoa(a);}
function makeAuth(sec,salt,ch){if(!window.crypto||!crypto.subtle)return Promise.resolve('');var enc=new TextEncoder();return crypto.subtle.digest('SHA-256',enc.encode(sec+salt)).then(function(h){return crypto.subtle.digest('SHA-256',enc.encode(b64(h)+ch));}).then(function(h){return b64(h);});}
var ws=null,wsRetry=null,msgId=1,pending={};
function wsSend(op,d){if(ws&&ws.readyState===1)ws.send(JSON.stringify({op:op,d:d}));}
function wsRequest(t,d,cb){var id='r'+(msgId++);pending[id]=cb;wsSend(6,{requestType:t,requestData:d||{},requestId:id});}
function updateLive(){var t=$('#recTxt');if(!t)return;t.textContent=streaming?'LIVE':recording?'REC':obsConnected?'IDLE':'LIVE';}
function connectOBS(){
if(ws)return;try{ws=new WebSocket('ws://127.0.0.1:'+wsPort);}catch(e){return;}
ws.onmessage=function(ev){var m;try{m=JSON.parse(ev.data);}catch(e){return;}
if(m.op===0){var auth=m.d&&m.d.authentication,ident={rpcVersion:1,eventSubscriptions:73},fin=function(){wsSend(1,ident);};if(auth&&wsPass)makeAuth(wsPass,auth.salt,auth.challenge).then(function(t){ident.authentication=t;fin();}).catch(fin);else fin();}
else if(m.op===2){obsConnected=true;updateLive();wsRequest('GetStreamStatus',{},function(d){if(d&&d.responseData)streaming=!!d.responseData.outputActive;updateLive();});wsRequest('GetRecordStatus',{},function(d){if(d&&d.responseData)recording=!!d.responseData.outputActive;updateLive();});}
else if(m.op===7){var cb=pending[m.d.requestId];if(cb){delete pending[m.d.requestId];cb(m.d);}}
else if(m.op===5&&m.d.eventType==='OutputStateChanged'){var on=String(m.d.eventData.outputState||'').indexOf('STARTED')>-1;if(m.d.eventData.outputType==='STREAM')streaming=on;if(m.d.eventData.outputType==='RECORD')recording=on;updateLive();}
};
ws.onclose=function(){ws=null;obsConnected=false;updateLive();clearTimeout(wsRetry);wsRetry=setTimeout(connectOBS,5000);};
}

var start=Date.now();
function tickUp(){
var s=Math.floor((Date.now()-start)/1000);
var t=Math.floor(s/3600)+':'+String(Math.floor(s%3600/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
var u=$('#uptime');if(u)u.textContent=t;
var iu=$('#islUp');if(iu)iu.textContent=t;
}
function sessTick(){
var now=new Date(),uH=now.getUTCHours();
$$('.isl-sess .sd').forEach(function(el){
var r=RANGES[el.dataset.tz];
el.classList.toggle('open',!!(r&&uH>=r[0]&&uH<r[1]));
});
$$('.isl-clk').forEach(function(el){
try{el.querySelector('.ct').textContent=new Intl.DateTimeFormat('en-GB',{timeZone:el.dataset.tz,hour:'2-digit',minute:'2-digit',hour12:false}).format(now);}catch(e){}
var r=RANGES[el.dataset.tz];
el.classList.toggle('open',!!(r&&uH>=r[0]&&uH<r[1]));
});
nextScheduleLine();
}
var lastP={BTC:67240,ETH:3512,XAU:2384,KES:129.2};
function fmtP(v){return v>=1000?Math.round(v).toLocaleString('en-US'):(v>=100?v.toFixed(1):v.toFixed(2));}
function setPrice(k,v,p){var ch=Math.abs(v-lastP[k])>1e-9;lastP[k]=v;$$('[data-sym="'+k+'"]').forEach(function(el){var pv=el.querySelector('.pv'),pc=el.querySelector('.pc');if(pv)pv.textContent=fmtP(v);if(pc&&p!=null){pc.textContent=(p>=0?'▲':'▼')+Math.abs(p).toFixed(1)+'%';pc.className='pc num '+(p>=0?'up':'down');}if(ch&&pv){pv.classList.remove('flash');void pv.offsetWidth;pv.classList.add('flash');}});}
function setPair(v,p){
var pv=$('#islPv');if(pv)pv.textContent=v.toFixed(4);
var pc=$('#islPc');if(pc){pc.textContent=(p>=0?'▲':'▼')+Math.abs(p).toFixed(2)+'%';pc.className='pc '+(p>=0?'up':'down');}
}
function prices(){fetch('https://api.binance.com/api/v3/ticker/24hr?symbols='+encodeURIComponent('["BTCUSDT","ETHUSDT","PAXGUSDT","EURUSDT"]')).then(function(r){return r.json();}).then(function(l){l.forEach(function(t){var k=t.symbol==='BTCUSDT'?'BTC':t.symbol==='ETHUSDT'?'ETH':t.symbol==='PAXGUSDT'?'XAU':null;if(k)setPrice(k,parseFloat(t.lastPrice),parseFloat(t.priceChangePercent));if(t.symbol==='EURUSDT')setPair(parseFloat(t.lastPrice),parseFloat(t.priceChangePercent));});setPrice('KES',lastP.KES+(Math.random()-.5)*.08,null);}).catch(function(){setPrice('BTC',lastP.BTC*(1+(Math.random()-.5)*.004),null);setPrice('ETH',lastP.ETH*(1+(Math.random()-.5)*.004),null);setPrice('XAU',lastP.XAU*(1+(Math.random()-.5)*.002),null);setPrice('KES',lastP.KES+(Math.random()-.5)*.08,null);});}
function marquee(){var track=$('#tkTrack');if(!track)return;var seq=track.querySelector('.seq'),W=0,x=0,lf=!!tweaks.layout.tickerFlipped,last=performance.now();function meas(){W=seq?seq.getBoundingClientRect().width:0;x=tweaks.layout.tickerFlipped?-W:0;}meas();addEventListener('resize',meas);(function step(now){var dt=Math.min(50,now-last);last=now;var fl=!!tweaks.layout.tickerFlipped;if(fl!==lf){lf=fl;x=fl?-W:0;}if(W>0){var sp=track.matches(':hover')?0:(Number(tweaks.layout.tickerSpeed)||55);if(fl){x+=dt*(sp/1000);if(x>=0)x-=W;}else{x-=dt*(sp/1000);if(-x>=W)x+=W;}track.style.transform='translateX('+x+'px)';}requestAnimationFrame(step);})(last);}
function market(){var H=440,N=48,SLOT=1920/N,g=$('#mglow'),s=$('#msharp');if(!g)return;var cl=[],v=230;for(var i=0;i<N;i++){v+=Math.sin(i*.55)*14+(Math.random()-.5)*36;v=Math.max(70,Math.min(380,v));cl.push(v);}function rd(){var p='';for(var j=0;j<N;j++)p+=(j*SLOT+SLOT/2)+','+(H-cl[j])+' ';g.setAttribute('points',p);s.setAttribute('points',p);}rd();setInterval(function(){cl.shift();cl.push(Math.max(70,Math.min(380,cl[N-2]+(Math.random()-.48)*30)));rd();},650);}
var lastEventId='';
function statePoll(){fetch('state.json?t='+Date.now(),{cache:'no-store'}).then(function(r){return r.ok?r.json():null;}).then(function(d){
if(!d)return;
if(d.goal&&window.CAP){window.CAP.goal={c:Math.max(0,parseInt(d.goal.current||0,10)),t:Math.max(1,parseInt(d.goal.target||1000,10))};}
if(d.announce&&window.CAP){window.CAP.ann=d.announce;window.CAP.annUntil=Date.now()+20000;}
if(d.chat){showChatDrawer(d.chat);}
if(d.event&&d.event.id&&d.event.id!==lastEventId){lastEventId=d.event.id;fireIsland(d.event);}
if(d.trades&&window.__tradesFeed){window.__tradesFeed(d.trades);}
}).catch(function(){});}

connectOBS();
currentCamKey=desiredCamKey();
setTimeout(startCam,500);
setInterval(tickUp,1000);tickUp();
setInterval(sessTick,1000);sessTick();
setInterval(prices,5000);prices();
setInterval(statePoll,3000);statePoll();
marquee();market();
}

function paintSpot(){var a=$('#spot-author'),v=$('#spot-text-v');if(v)v.textContent=tweaks.spot.text||'';if(a)a.textContent=tweaks.spot.author||'mod';}
window.addEventListener('smile-tweaks',paintSpot);

function initSmile(){
setInterval(function(){if(document.hidden)return;$$('.smile-anim').forEach(function(s){if(!s.classList.contains('is-blink')&&Math.random()<.18){s.classList.add('is-blink');setTimeout(function(){s.classList.remove('is-blink');},160);}});},3400);
}

if(isControl){
$('#viewerApp').style.display='none';
$('#controlPanel').classList.add('active');
initControl();
applyTweaks(tweaks,false);
}else{
$('#controlPanel').style.display='none';
$('#viewerApp').classList.add('active');
applyTweaks(tweaks,true);
paintSpot();
initViewer();
setTimeout(function(){positionMeet();applyLayout(true);},80);
setTimeout(function(){positionMeet();applyLayout(true);},450);
}
initSmile();
})();
</script>
</body>
</html>
