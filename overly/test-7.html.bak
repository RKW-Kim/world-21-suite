<span class="cd-item" id="cdGoal"><b class="cd-lbl">GOAL</b><span class="cd-tube"><span class="fill" id="cdGoalFill" style="width:0%"><i></i><i></i><i></i></span></span><span class="num" id="cdGoalTxt">0/1,000</span></span>
